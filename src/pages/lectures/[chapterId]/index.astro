---
import Layout from '../../../layouts/Layout.astro';
import I18nTitle from '../../../components/I18nTitle.astro';
import { getCatalog, getAppConfig, formatDuration, en, chapterSlug, lectureSlug, playStoreUrl } from '../../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.chapters.map(chapter => ({
    params: { chapterId: chapterSlug(chapter.id) },
    props: { chapterId: chapter.id },
  }));
}

const { chapterId } = Astro.props;
const [catalog, appConfig] = await Promise.all([getCatalog(), getAppConfig()]);
const chapter = catalog.chapters.find(c => c.id === chapterId)!;
const lectures = catalog.lectures.filter(l => l.chapterId === chapterId);
const totalSecs = lectures.reduce((s, l) => s + l.durationSeconds, 0);
const storeUrl = playStoreUrl(appConfig);
---

<Layout
  title={`${en(chapter.title)} — Sharah Kitab al-Tawheed`}
  description={`${lectures.length} audio parts from ${en(chapter.title)} — Sharah Kitab al-Tawheed by Shaikh Rahmani. ${formatDuration(totalSecs)} total.`}
  appConfig={appConfig}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> →
      <a href="/lectures/" class="hover:text-[#C9A84C]">Lectures</a> →
      {en(chapter.title)}
    </nav>

    <div class="mb-8">
      <p class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-1">Class {String(chapter.number).padStart(2,'0')}</p>
      <I18nTitle field={chapter.title} as="h1" class="text-3xl font-bold mb-2" urduClass="text-[#C9A84C] text-lg mb-2" />
      <p class="text-fg-2">{lectures.length} {lectures.length === 1 ? 'part' : 'parts'} · {formatDuration(totalSecs)}</p>
    </div>

    <div class="space-y-2 mb-10">
      {lectures.map((lecture) => (
        <a href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(lecture)}/`}
          class="group flex items-center gap-3 bg-surface border border-[var(--divider)] rounded-xl px-4 sm:px-5 py-4 hover:border-[#C9A84C]/40 hover:bg-surface-hover transition-all min-w-0">
          <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
            <span class="w-8 h-8 flex items-center justify-center bg-[#C9A84C]/10 text-[#C9A84C] text-xs font-bold rounded-lg shrink-0">
              {String(lecture.number).padStart(2,'0')}
            </span>
            <div class="min-w-0">
              <I18nTitle
                field={lecture.title}
                as="p"
                class="font-semibold text-sm group-hover:text-[#C9A84C] transition-colors truncate"
                urduClass="text-xs text-fg-3 mt-0.5 truncate"
              />
              <p class="text-xs text-fg-3">{formatDuration(lecture.durationSeconds)}</p>
            </div>
          </div>
          <span class="text-[#C9A84C] text-xs border border-[#C9A84C]/30 rounded-full px-2 py-0.5 group-hover:bg-[#C9A84C]/10 transition-colors shrink-0 ml-2">▶ Play</span>
        </a>
      ))}
    </div>

    <div class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-5 text-center">
      <p class="font-semibold mb-1">Want offline access?</p>
      <p class="text-sm text-fg-2 mb-4">Download the free Android app — listen without internet, track your progress, enable Study Mode.</p>
      <a href={storeUrl} target="_blank" rel="noopener"
        class="inline-block bg-[#C9A84C] text-black font-bold px-6 py-2.5 rounded-lg text-sm hover:bg-[#D4B55C] transition-colors mr-2">
        Google Play
      </a>
      <a href="/download/" class="inline-block text-[#C9A84C] text-sm hover:underline mt-2 sm:mt-0">
        App details →
      </a>
    </div>
  </div>
</Layout>
