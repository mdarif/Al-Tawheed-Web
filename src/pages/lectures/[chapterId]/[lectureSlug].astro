---
import Layout from "../../../layouts/Layout.astro";
import LectureAudioPlayer from "../../../components/LectureAudioPlayer.astro";
import ChapterCompleteCard from "../../../components/ChapterCompleteCard.astro";
import {
  getCatalog,
  getAppConfig,
  formatDuration,
  en,
  chapterSlug,
  lectureSlug,
  playStoreUrl,
  bookCoverOgUrl,
  nextChapter,
  firstLectureInChapter,
} from "../../../lib/catalog";

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.lectures.map((lecture) => {
    const chapter = catalog.chapters.find((c) => c.id === lecture.chapterId)!;
    return {
      params: {
        chapterId: chapterSlug(chapter.id),
        lectureSlug: lectureSlug(lecture),
      },
      props: { lectureId: lecture.id, chapterId: chapter.id },
    };
  });
}

const { lectureId, chapterId } = Astro.props;
const [catalog, appConfig] = await Promise.all([getCatalog(), getAppConfig()]);
const lecture = catalog.lectures.find((l) => l.id === lectureId)!;
const chapter = catalog.chapters.find((c) => c.id === chapterId)!;
const allChapterLectures = catalog.lectures.filter(
  (l) => l.chapterId === chapterId
);
const currentIdx = allChapterLectures.findIndex((l) => l.id === lectureId);
const prev = allChapterLectures[currentIdx - 1];
const next = allChapterLectures[currentIdx + 1];
const storeUrl = playStoreUrl(appConfig);
const lecturePath = `/lectures/${chapterSlug(chapter.id)}/${lectureSlug(lecture)}/`;

const followingChapter = nextChapter(catalog, chapter);
const followingChapterHref = followingChapter
  ? (() => {
      const first = firstLectureInChapter(catalog, followingChapter.id);
      return first
        ? `/lectures/${chapterSlug(followingChapter.id)}/${lectureSlug(first)}/`
        : `/lectures/${chapterSlug(followingChapter.id)}/`;
    })()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AudioObject",
  name: en(lecture.title),
  description: `${en(lecture.title)} from Sharah Kitab al-Tawheed by Shaikh Abdullah Nasir Rahmani Hafizaullah`,
  duration: `PT${Math.floor(lecture.durationSeconds / 60)}M${lecture.durationSeconds % 60}S`,
  encodingFormat: "audio/mpeg",
  contentUrl: lecture.audioUrl,
  thumbnailUrl: bookCoverOgUrl(catalog.book),
  inLanguage: "ur",
  isPartOf: {
    "@type": "Course",
    name: en(catalog.book.title),
    description: "Complete audio series on Kitab al-Tawheed",
  },
};

// Dynamic OG metadata for individual lessons — optimized for social sharing
const ogTitle = `Part ${String(lecture.number).padStart(2, "0")}: ${en(lecture.title)} — Kitab At-Tawheed`;
const ogDescription = `${en(lecture.title)} from the complete Sharah by Shaikh Abdullah Nasir Rahmani. ${formatDuration(lecture.durationSeconds)} of free Urdu Islamic education. Listen online free—no app required.`;
const articleTags = [
  "Tawheed",
  "Islamic Studies",
  "Quran",
  "Sunnah",
  en(chapter.title),
];
---

<Layout
  title={ogTitle}
  description={ogDescription}
  {appConfig}
  ogImage={bookCoverOgUrl(catalog.book)}
  ogImageAlt={`${en(lecture.title)} — Sharah Kitab At-Tawheed`}
  ogType="article"
  {articleTags}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://kitabattawheed.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Lectures",
          item: "https://kitabattawheed.com/lectures/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Urdu Series",
          item: "https://kitabattawheed.com/lectures/urdu/",
        },
        {
          "@type": "ListItem",
          position: 4,
          name: en(chapter.title),
          item: `https://kitabattawheed.com/lectures/${chapterSlug(chapter.id)}/`,
        },
        {
          "@type": "ListItem",
          position: 5,
          name: en(lecture.title),
          item: `https://kitabattawheed.com${lecturePath}`,
        },
      ],
    })}
    slot="head"
  />

  <article
    class="mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-10 min-w-0"
    data-pagefind-body
  >
    <nav
      class="text-xs text-fg-3 mb-6 break-words leading-relaxed"
      aria-label="Breadcrumb"
    >
      <a href="/" class="hover:text-[#C9A84C]">Home</a>
      <span class="mx-1">→</span>
      <a href="/lectures/" class="hover:text-[#C9A84C]">Lectures</a>
      <span class="mx-1">→</span>
      <a href="/lectures/urdu/" class="hover:text-[#C9A84C]">Urdu Series</a>
      <span class="mx-1">→</span>
      <a
        href={`/lectures/${chapterSlug(chapter.id)}/`}
        class="hover:text-[#C9A84C]">{en(chapter.title)}</a
      >
      <span class="mx-1">→</span>
      <span class="text-fg-2">{en(lecture.title)}</span>
    </nav>

    <div class="mb-6">
      <p
        class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-1"
      >
        Class {String(chapter.number).padStart(2, "0")} · Part {currentIdx + 1} of
        {allChapterLectures.length}
      </p>
      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-1 text-balance">
        {en(lecture.title)}
      </h1>
      <div class="flex items-center gap-3 flex-wrap mt-1">
        <p class="text-fg-2 text-sm">
          {formatDuration(lecture.durationSeconds)} · By {en(catalog.book.speaker)}
        </p>
        <button
          id="share-btn"
          type="button"
          class="flex items-center gap-1.5 text-xs text-fg-3 border border-[var(--divider)] rounded-lg px-3 py-1.5 hover:text-fg hover:border-[var(--divider-md)] transition-colors shrink-0"
          aria-label="Share this lecture"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Share
        </button>
      </div>
    </div>

    <div
      id="share-toast"
      class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-surface border border-[var(--divider)] rounded-xl px-4 py-2.5 text-sm shadow-lg opacity-0 pointer-events-none transition-opacity duration-300"
      aria-live="polite"
    >
      Link copied!
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('share-btn');
        var toast = document.getElementById('share-toast');
        var toastTimer;

        function showToast(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.remove('opacity-0');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toast.classList.add('opacity-0');
          }, 2200);
        }

        function copyFallback() {
          navigator.clipboard.writeText(location.href).then(function () {
            showToast('Link copied!');
          }).catch(function () {
            showToast('Copy: ' + location.href);
          });
        }

        if (btn) {
          btn.addEventListener('click', function () {
            if (navigator.share) {
              navigator.share({
                title: document.title,
                text: 'Free Urdu Islamic lecture — Sharah Kitab al-Tawheed',
                url: location.href,
              }).catch(function (e) {
                if (e.name !== 'AbortError') copyFallback();
              });
            } else {
              copyFallback();
            }
          });
        }
      })();
    </script>

    <LectureAudioPlayer
      lectureId={lecture.id}
      {lecturePath}
      lectureTitle={en(lecture.title)}
      audioUrl={lecture.audioUrl}
      durationSeconds={lecture.durationSeconds}
      speaker={en(catalog.book.speaker)}
      playStoreUrl={storeUrl}
      coverImageUrl={catalog.book.coverImageUrl}
    />

    <div
      class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
    >
      <div class="min-w-0">
        <p class="text-sm font-semibold text-[#C9A84C]">Continue On The App</p>
        <p class="text-xs text-fg-2">Offline · Study Mode · Background Play</p>
      </div>
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="shrink-0 w-full sm:w-auto text-center bg-[#C9A84C] text-black font-bold px-4 py-3 sm:py-2 rounded-lg text-sm sm:text-xs hover:bg-[#D4B55C] transition-colors min-h-[44px] sm:min-h-0 flex items-center justify-center"
      >
        Get App
      </a>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      {
        prev && (
          <a
            href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(prev)}/`}
            class="flex-1 bg-surface border border-[var(--divider)] rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all text-left min-w-0"
          >
            <p class="text-xs text-fg-3 mb-1">← Previous</p>
            <p class="text-sm font-semibold truncate">{en(prev.title)}</p>
          </a>
        )
      }
      {
        next && (
          <a
            href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(next)}/`}
            class="flex-1 bg-surface border border-[var(--divider)] rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all sm:text-right min-w-0"
          >
            <p class="text-xs text-fg-3 mb-1">Next →</p>
            <p class="text-sm font-semibold truncate">{en(next.title)}</p>
          </a>
        )
      }
    </div>

    {
      !next && (
        <ChapterCompleteCard
          chapter={chapter}
          nextChapter={followingChapter}
          nextChapterHref={followingChapterHref}
          playStoreUrl={storeUrl}
        />
      )
    }

    <div class="mt-8">
      <h2 class="text-sm font-bold text-fg-2 uppercase tracking-widest mb-3">
        All parts in {en(chapter.title)}
      </h2>
      <div class="space-y-1.5">
        {
          allChapterLectures.map((l) => (
            <a
              href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(l)}/`}
              class={`flex items-center justify-between px-4 py-2.5 rounded-lg text-sm transition-all gap-3 ${l.id === lecture.id ? "bg-[#C9A84C]/15 border border-[#C9A84C]/30 text-[#C9A84C]" : "hover:bg-surface-hover text-fg-2"}`}
            >
              <span class="min-w-0">
                <span class="block truncate">{en(l.title)}</span>
              </span>
              <span class="text-xs shrink-0">
                {formatDuration(l.durationSeconds)}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </article>
</Layout>
