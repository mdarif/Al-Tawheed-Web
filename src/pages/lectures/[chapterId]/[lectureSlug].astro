---
import Layout from '../../../layouts/Layout.astro';
import { getCatalog, getAppConfig, formatDuration, en, chapterSlug, lectureSlug } from '../../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.lectures.map(lecture => {
    const chapter = catalog.chapters.find(c => c.id === lecture.chapterId)!;
    return {
      params: { chapterId: chapterSlug(chapter.id), lectureSlug: lectureSlug(lecture) },
      props: { lectureId: lecture.id, chapterId: chapter.id },
    };
  });
}

const { lectureId, chapterId } = Astro.props;
const [catalog, appConfig] = await Promise.all([getCatalog(), getAppConfig()]);
const lecture = catalog.lectures.find(l => l.id === lectureId)!;
const chapter = catalog.chapters.find(c => c.id === chapterId)!;
const allChapterLectures = catalog.lectures.filter(l => l.chapterId === chapterId);
const currentIdx = allChapterLectures.findIndex(l => l.id === lectureId);
const prev = allChapterLectures[currentIdx - 1];
const next = allChapterLectures[currentIdx + 1];
const playStoreUrl = appConfig.links.playStore ?? 'https://play.google.com/store/apps/details?id=com.almarfa.tawheed';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AudioObject",
  "name": en(lecture.title),
  "description": `${en(lecture.title)} from Sharah Kitab al-Tawheed by Shaikh Abdullah Nasir Rahmani`,
  "duration": `PT${Math.floor(lecture.durationSeconds/60)}M${lecture.durationSeconds%60}S`,
  "encodingFormat": "audio/mpeg",
  "contentUrl": lecture.audioUrl,
  "inLanguage": "ur",
  "isPartOf": {
    "@type": "Course",
    "name": en(catalog.book.title),
    "description": "Complete audio series on Kitab al-Tawheed"
  }
};
---

<Layout
  title={`${en(lecture.title)} — Sharah Kitab al-Tawheed`}
  description={`Listen to ${en(lecture.title)} from Sharah Kitab al-Tawheed. ${formatDuration(lecture.durationSeconds)} Urdu audio by Shaikh Abdullah Nasir Rahmani.`}
  appConfig={appConfig}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="mx-auto max-w-3xl px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="text-xs text-[#6B6458] mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> →
      <a href="/lectures/" class="hover:text-[#C9A84C]">Lectures</a> →
      <a href={`/lectures/${chapterSlug(chapter.id)}/`} class="hover:text-[#C9A84C]">{en(chapter.title)}</a> →
      {en(lecture.title)}
    </nav>

    <!-- Title -->
    <div class="mb-6">
      <p class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-1">
        Class {String(chapter.number).padStart(2,'0')} · Part {currentIdx + 1} of {allChapterLectures.length}
      </p>
      <h1 class="text-2xl md:text-3xl font-bold mb-1">{en(lecture.title)}</h1>
      <p class="text-[#A09880] text-sm">{formatDuration(lecture.durationSeconds)} · By {en(catalog.book.speaker)}</p>
    </div>

    <!-- Audio player -->
    <div class="bg-[#1A1A1C] border border-white/10 rounded-2xl p-5 mb-6">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-[#C9A84C]/10 rounded-xl flex items-center justify-center shrink-0">
          <span class="text-[#C9A84C] text-2xl">🎧</span>
        </div>
        <div>
          <p class="font-semibold">{en(lecture.title)}</p>
          <p class="text-xs text-[#A09880]">{en(catalog.book.speaker)}</p>
        </div>
      </div>
      <audio
        controls
        preload="none"
        class="w-full rounded-lg accent-[#C9A84C]"
        src={lecture.audioUrl}
      >
        Your browser does not support audio. <a href={lecture.audioUrl} class="text-[#C9A84C] underline">Download MP3</a>
      </audio>
      <p class="text-xs text-[#6B6458] mt-2 text-center">
        {formatDuration(lecture.durationSeconds)} · Urdu audio
      </p>
    </div>

    <!-- App nudge -->
    <div class="bg-[#1E1A0F] border border-[#C9A84C]/30 rounded-xl p-4 mb-6 flex items-center justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-[#C9A84C]">Continue on the app</p>
        <p class="text-xs text-[#A09880]">Offline · Progress tracking · Background play</p>
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener"
        class="shrink-0 bg-[#C9A84C] text-black font-bold px-4 py-2 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors">
        Get App
      </a>
    </div>

    <!-- Prev / Next -->
    <div class="flex gap-3">
      {prev && (
        <a href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(prev)}/`}
          class="flex-1 bg-[#1A1A1C] border border-white/10 rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all text-left">
          <p class="text-xs text-[#6B6458] mb-1">← Previous</p>
          <p class="text-sm font-semibold truncate">{en(prev.title)}</p>
        </a>
      )}
      {next && (
        <a href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(next)}/`}
          class="flex-1 bg-[#1A1A1C] border border-white/10 rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all text-right">
          <p class="text-xs text-[#6B6458] mb-1">Next →</p>
          <p class="text-sm font-semibold truncate">{en(next.title)}</p>
        </a>
      )}
    </div>

    <!-- All parts in this chapter -->
    <div class="mt-8">
      <h2 class="text-sm font-bold text-[#A09880] uppercase tracking-widest mb-3">All parts in {en(chapter.title)}</h2>
      <div class="space-y-1.5">
        {allChapterLectures.map((l) => (
          <a href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(l)}/`}
            class={`flex items-center justify-between px-4 py-2.5 rounded-lg text-sm transition-all ${l.id === lecture.id ? 'bg-[#C9A84C]/15 border border-[#C9A84C]/30 text-[#C9A84C]' : 'hover:bg-white/5 text-[#A09880]'}`}>
            <span>{en(l.title)}</span>
            <span class="text-xs">{formatDuration(l.durationSeconds)}</span>
          </a>
        ))}
      </div>
    </div>

  </div>
</Layout>
