---
import Layout from "../../../layouts/Layout.astro";
import {
  getCatalog,
  getAppConfig,
  en,
  formatDuration,
  chapterSlug,
  lectureSlug,
  playStoreUrl,
} from "../../../lib/catalog";

const [catalog, appConfig] = await Promise.all([getCatalog(), getAppConfig()]);
const storeUrl = playStoreUrl(appConfig);
const urduHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const classCount = catalog.chapters.length;
---

<Layout
  title="Urdu Series — Sharah Kitab at-Tawheed"
  {appConfig}
  description={`Browse all ${catalog.book.lectureCount} Urdu lectures across ${classCount} classes — Sharah Kitab at-Tawheed by Shaikh Abdullah Nasir Rahmani Hafizahullah. Free online Urdu audio.`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> →
      <a href="/lectures/" class="hover:text-[#C9A84C]">Lectures</a> →
      Urdu Series
    </nav>

    <p class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-1">
      Urdu Series
    </p>
    <h1 class="text-3xl font-bold mb-2">{en(catalog.book.title)}</h1>
    <p class="text-fg-2 mb-4">
      {catalog.book.lectureCount} Lectures · {classCount} Classes · {urduHours} Hours
      · By {en(catalog.book.speaker)}
    </p>

    <div class="mb-8 flex flex-wrap gap-3">
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="bg-[#C9A84C] text-black font-bold px-5 py-2.5 rounded-lg text-sm hover:bg-[#D4B55C] transition-colors"
      >
        Get the app
      </a>
      <a
        href="/sheikh-rahmani/"
        class="border border-[var(--divider)] text-fg-2 font-semibold px-5 py-2.5 rounded-lg text-sm hover:bg-surface-hover transition-colors"
      >
        About the teacher →
      </a>
      <a
        href="/arabic/"
        class="border border-[var(--divider)] text-fg-2 font-semibold px-5 py-2.5 rounded-lg text-sm hover:bg-surface-hover transition-colors"
      >
        Arabic Series →
      </a>
    </div>

    <a
      href="/urdu/book/"
      class="block mb-8 bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-4 hover:border-[#C9A84C]/60 transition-colors"
    >
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-sm font-bold text-[#C9A84C]">Read the book</p>
          <p class="text-xs text-fg-2">Kitab at-Tawheed — full Urdu text</p>
        </div>
        <span class="text-[#C9A84C] shrink-0 text-lg" aria-hidden="true">→</span>
      </div>
    </a>

    <div class="mb-8">
      <div class="relative max-w-md">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-fg-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="class-filter"
          type="search"
          placeholder="Filter classes…"
          autocomplete="off"
          class="w-full bg-surface border border-[var(--divider)] rounded-xl pl-10 pr-4 py-2.5 text-sm placeholder:text-fg-3 focus:outline-none focus:border-[#C9A84C]/60 transition-colors"
        />
      </div>
      <p id="full-search-hint" class="hidden mt-2 text-xs text-fg-3">
        Looking for a specific topic?
        <a id="full-search-link" href="/search/" class="text-[#C9A84C] hover:underline">Search all lecture content →</a>
      </p>
    </div>

    <div class="space-y-3">
      {
        catalog.chapters.map((chapter) => {
          const parts = catalog.lectures
            .filter((l) => l.chapterId === chapter.id)
            .sort((a, b) => a.number - b.number);
          const totalSecs = parts.reduce((s, l) => s + l.durationSeconds, 0);
          const titleWords = [
            `class ${String(chapter.number).padStart(2, "0")} ${en(chapter.title)}`,
            ...parts.map((l) => en(l.title)),
          ].join(" ").toLowerCase();
          return (
            <div
              class="class-card bg-surface border border-[var(--divider)] rounded-xl overflow-hidden hover:border-[#C9A84C]/40 transition-colors"
              data-title={titleWords}
            >
              <a
                href={`/lectures/${chapterSlug(chapter.id)}/`}
                class="group flex items-center justify-between px-5 py-4 hover:bg-surface-hover transition-colors"
              >
                <div class="flex items-center gap-4 min-w-0">
                  <span class="w-9 h-9 flex items-center justify-center bg-[#C9A84C]/10 text-[#C9A84C] text-xs font-bold rounded-lg shrink-0">
                    {String(chapter.number).padStart(2, "0")}
                  </span>
                  <div class="min-w-0">
                    <p class="font-semibold group-hover:text-[#C9A84C] transition-colors truncate">
                      {en(chapter.title)}
                    </p>
                    <p class="text-xs text-fg-3">
                      {chapter.lectureCount}{" "}
                      {chapter.lectureCount === 1 ? "part" : "parts"} ·{" "}
                      {formatDuration(totalSecs)}
                    </p>
                  </div>
                </div>
                <span class="text-fg-3 group-hover:text-[#C9A84C] transition-colors text-sm shrink-0 ml-2">
                  →
                </span>
              </a>
              <div class="border-t border-[var(--divider)] divide-y divide-[var(--divider)]">
                {parts.map((lecture) => (
                  <a
                    href={`/lectures/${chapterSlug(chapter.id)}/${lectureSlug(lecture)}/`}
                    class="flex items-center justify-between gap-3 pl-16 pr-5 py-2.5 text-sm hover:bg-surface-hover hover:text-[#C9A84C] transition-colors"
                  >
                    <span class="truncate">{en(lecture.title)}</span>
                    <span class="text-xs text-fg-3 shrink-0">
                      {formatDuration(lecture.durationSeconds)}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('class-filter') as HTMLInputElement | null;
  const hint = document.getElementById('full-search-hint');
  const link = document.getElementById('full-search-link') as HTMLAnchorElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.class-card');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();

    if (link) link.href = `/search/?q=${encodeURIComponent(input.value.trim())}`;
    if (hint) hint.classList.toggle('hidden', q.length === 0);

    let visible = 0;
    cards.forEach((card) => {
      const match = !q || (card.dataset.title ?? '').includes(q);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
  });
</script>
