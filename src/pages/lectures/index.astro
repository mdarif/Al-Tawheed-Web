---
import Layout from "../../layouts/Layout.astro";
import {
  getCatalog,
  getArabicCatalog,
  getAppConfig,
  en,
  ar,
} from "../../lib/catalog";

const [catalog, arabicCatalog, appConfig] = await Promise.all([
  getCatalog(),
  getArabicCatalog(),
  getAppConfig(),
]);

const urduHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const arabicHours = Math.floor(arabicCatalog.book.totalDurationSeconds / 3600);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const classCount = catalog.chapters.length;
const totalCount = urduCount + arabicCount;
---

<Layout
  title="All Lectures — Kitab at-Tawheed (Urdu & Arabic)"
  {appConfig}
  description={`Browse the Kitab at-Tawheed audio series: ${urduCount} Urdu lectures across ${classCount} classes by Shaikh Abdullah Nasir Rahmani, and ${arabicCount} Arabic duroos by Shaikh Salih al-Fawzan. Free online.`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> → Lectures
    </nav>

    <h1 class="text-3xl font-bold mb-2">All Lectures</h1>
    <p class="text-fg-2 mb-8">
      Two audio series · {totalCount} lessons · Free
    </p>

    <!-- Choose a series -->
    <h2 class="text-xs font-bold text-fg-3 uppercase tracking-widest mb-3">
      Choose a series
    </h2>
    <div class="grid gap-4 max-w-2xl mx-auto">
      <!-- Urdu series -->
      <a
        href="/lectures/urdu/"
        class="group flex items-center gap-5 sm:gap-6 bg-surface border border-[var(--divider)] rounded-2xl p-6 sm:p-7 hover:border-[#C9A84C]/50 hover:bg-surface-hover transition-all"
      >
        <img
          src="/sheikh-abdullah-nasir-rahmani.jpg"
          alt="Shaikh Abdullah Nasir Rahmani"
          width="112"
          height="112"
          class="w-20 h-20 sm:w-28 sm:h-28 rounded-full object-cover shrink-0 border-2 border-[#C9A84C]/25"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="text-[#C9A84C] text-[11px] font-bold uppercase tracking-widest mb-1">
            Urdu Series
          </p>
          <p class="text-lg sm:text-2xl font-bold leading-snug group-hover:text-[#C9A84C] transition-colors">
            {en(catalog.book.title)}
          </p>
          <p class="text-sm text-fg-3 mt-1">{en(catalog.book.speaker)}</p>
          <p class="text-sm text-fg-2 mt-2.5">
            {urduCount} lectures · {classCount} classes · {urduHours}h
          </p>
          <p class="text-sm font-semibold text-[#C9A84C] mt-2.5">Browse the Urdu series →</p>
        </div>
      </a>

      <!-- Arabic series -->
      <a
        href="/arabic/"
        class="group flex items-center gap-5 sm:gap-6 bg-surface border border-[var(--divider)] rounded-2xl p-6 sm:p-7 hover:border-[#C9A84C]/50 hover:bg-surface-hover transition-all"
      >
        <img
          src="/sheikh-fawzan.png"
          alt="Shaikh Salih al-Fawzan"
          width="112"
          height="112"
          class="w-20 h-20 sm:w-28 sm:h-28 rounded-full object-cover shrink-0 border-2 border-[#C9A84C]/25"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="text-[#C9A84C] text-[11px] font-bold uppercase tracking-widest mb-1">
            Arabic Series
          </p>
          <p
            class="text-lg sm:text-2xl font-bold leading-snug group-hover:text-[#C9A84C] transition-colors"
            dir="rtl"
            lang="ar"
            style="font-family:'Noto Naskh Arabic',system-ui,sans-serif"
          >
            {ar(arabicCatalog.book.title) || en(arabicCatalog.book.title)}
          </p>
          <p class="text-sm text-fg-3 mt-1">{en(arabicCatalog.book.speaker)}</p>
          <p class="text-sm text-fg-2 mt-2.5">
            {arabicCount} duroos · {arabicHours}h
          </p>
          <p class="text-sm font-semibold text-[#C9A84C] mt-2.5">Browse the Arabic series →</p>
        </div>
      </a>
    </div>
  </div>
</Layout>
