---
import Layout from "../../layouts/Layout.astro";
import {
  getCatalog,
  getArabicCatalog,
  getAppConfig,
  en,
  ar,
  bookCoverSrc,
} from "../../lib/catalog";

const [catalog, arabicCatalog, appConfig] = await Promise.all([
  getCatalog(),
  getArabicCatalog(),
  getAppConfig(),
]);

const urduHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const arabicHours = Math.floor(arabicCatalog.book.totalDurationSeconds / 3600);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const classCount = catalog.chapters.length;
const totalCount = urduCount + arabicCount;
---

<Layout
  title="All Lectures — Kitab al-Tawheed (Urdu & Arabic)"
  {appConfig}
  description={`Browse the Kitab al-Tawheed audio series: ${urduCount} Urdu lectures across ${classCount} classes by Shaikh Abdullah Nasir Rahmani, and ${arabicCount} Arabic duroos by Shaikh Salih al-Fawzan. Free online.`}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> → Lectures
    </nav>

    <h1 class="text-3xl font-bold mb-2">All Lectures</h1>
    <p class="text-fg-2 mb-8">
      Two audio series · {totalCount} lessons · Free
    </p>

    <!-- Choose a series -->
    <h2 class="text-xs font-bold text-fg-3 uppercase tracking-widest mb-3">
      Choose a series
    </h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <!-- Urdu series -->
      <a
        href="/lectures/urdu/"
        class="group flex gap-4 bg-surface border border-[var(--divider)] rounded-2xl p-5 hover:border-[#C9A84C]/50 hover:bg-surface-hover transition-all"
      >
        <img
          src={bookCoverSrc(catalog.book)}
          alt=""
          width="72"
          height="72"
          class="w-16 h-16 rounded-xl object-cover shrink-0 border border-[#C9A84C]/20"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="text-[#C9A84C] text-[11px] font-bold uppercase tracking-widest mb-0.5">
            Urdu Series
          </p>
          <p class="font-semibold leading-snug group-hover:text-[#C9A84C] transition-colors">
            {en(catalog.book.title)}
          </p>
          <p class="text-xs text-fg-3 mt-0.5">{en(catalog.book.speaker)}</p>
          <p class="text-xs text-fg-2 mt-2">
            {urduCount} lectures · {classCount} classes · {urduHours}h
          </p>
          <p class="text-xs font-semibold text-[#C9A84C] mt-2">Browse Urdu series →</p>
        </div>
      </a>

      <!-- Arabic series -->
      <a
        href="/arabic/"
        class="group flex gap-4 bg-surface border border-[var(--divider)] rounded-2xl p-5 hover:border-[#C9A84C]/50 hover:bg-surface-hover transition-all"
      >
        <img
          src={bookCoverSrc(arabicCatalog.book)}
          alt=""
          width="72"
          height="72"
          class="w-16 h-16 rounded-xl object-cover shrink-0 border border-[#C9A84C]/20"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="text-[#C9A84C] text-[11px] font-bold uppercase tracking-widest mb-0.5">
            Arabic Series
          </p>
          <p
            class="font-semibold leading-snug group-hover:text-[#C9A84C] transition-colors"
            dir="rtl"
            lang="ar"
            style="font-family:'Noto Naskh Arabic',system-ui,sans-serif"
          >
            {ar(arabicCatalog.book.title) || en(arabicCatalog.book.title)}
          </p>
          <p class="text-xs text-fg-3 mt-0.5">{en(arabicCatalog.book.speaker)}</p>
          <p class="text-xs text-fg-2 mt-2">
            {arabicCount} duroos · {arabicHours}h
          </p>
          <p class="text-xs font-semibold text-[#C9A84C] mt-2">Browse Arabic series →</p>
        </div>
      </a>
    </div>
  </div>
</Layout>
