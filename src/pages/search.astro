---
import Layout from '../layouts/Layout.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import { getAppConfig } from '../lib/catalog';

const appConfig = await getAppConfig();
---

<Layout
  title="Search Lectures — Sharah Kitab al-Tawheed"
  description="Search the Kitab al-Tawheed audio series — Urdu lectures and Arabic duroos — by class, title, or topic."
  appConfig={appConfig}
>
  <article class="search-page mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-10 min-w-0" data-pagefind-ignore>
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> → Search
    </nav>
    <h1 class="text-3xl font-bold mb-2">Search Lectures</h1>
    <p class="text-fg-2 mb-8 text-sm">
      Find any lesson across both series. Try "class 05", "shirk", or "tawheed".
    </p>

    <div class="tawheed-search" id="tawheed-search-widget" data-pf-theme="dark">
      <PagefindConfig />
      <pagefind-input
        class="tawheed-pagefind-input"
        debounce="200"
        autofocus
        placeholder="Search lectures…"
      ></pagefind-input>
      <pagefind-summary class="tawheed-pagefind-summary"></pagefind-summary>
      <pagefind-results
        class="tawheed-pagefind-results"
        show-sub-results
        max-results="24"
      ></pagefind-results>
    </div>
  </article>
</Layout>

<script>
  // Sync pagefind theme attribute with site theme
  function syncPfTheme() {
    const widget = document.getElementById('tawheed-search-widget');
    if (!widget) return;
    const isLight = document.documentElement.dataset.theme === 'light';
    widget.setAttribute('data-pf-theme', isLight ? 'light' : 'dark');
  }
  syncPfTheme();
  // Re-sync if theme changes (MutationObserver on html element)
  new MutationObserver(syncPfTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<script>
  async function applyInitialQuery() {
    const q = new URLSearchParams(window.location.search).get('q')?.trim();
    if (!q) return;
    await customElements.whenDefined('pagefind-input');
    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    const host = document.querySelector('pagefind-input');
    const input =
      host?.shadowRoot?.querySelector('input') ??
      host?.querySelector('input');
    if (input instanceof HTMLInputElement) {
      input.value = q;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    }
  }
  applyInitialQuery();
</script>
