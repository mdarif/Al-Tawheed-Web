---
import Layout from "../../layouts/Layout.astro";
import ContinueListening from "../../components/ContinueListening.astro";
import DailyBenefitCard from "../../components/DailyBenefitCard.astro";
import { getCatalog, getArabicCatalog, getAppConfig, playStoreUrl } from "../../lib/catalog";
import { t, tx, getLocalePaths } from "../../lib/i18n";

export function getStaticPaths() {
  return getLocalePaths();
}

const { locale } = Astro.params;
const [catalog, arabicCatalog, appConfig] = await Promise.all([getCatalog(), getArabicCatalog(), getAppConfig()]);
const storeUrl = playStoreUrl(appConfig);
const totalHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const i18n = t(locale);
---

<Layout
  title={locale === "ur"
    ? "شرح کتاب التوحید | اردو آڈیو سلسلہ"
    : "Sharah Kitab al-Tawheed | Audio Series"}
  description={tx(i18n.hero.description, {
    count: catalog.book.lectureCount,
    arabicCount,
  })}
  {appConfig}
>
  <!-- Hero -->
  <section
    class="mx-auto max-w-5xl px-4 sm:px-6 pt-10 sm:pt-14 pb-10 text-center"
    dir="rtl"
  >
    <p
      class="text-[#C9A84C] text-sm font-semibold tracking-widest uppercase mb-4 font-urdu"
    >
      {i18n.hero.eyebrow}
    </p>
    <h1
      class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-3 text-balance font-urdu"
    >
      {catalog.book.title.ur ?? "شرح کتاب التوحید"}
    </h1>
    <p class="text-fg-2 text-base sm:text-lg mb-4 px-1 font-urdu">
      {
        tx(i18n.hero.description, {
          count: catalog.book.lectureCount,
          arabicCount,
        })
      }
    </p>

    <div class="flex justify-center mb-6">
      <div
        class="inline-flex items-center gap-2 bg-surface border border-[var(--divider)] rounded-full px-4 py-1.5 text-xs text-fg-2 font-urdu"
      >
        <span class="flex -space-x-1.5">
          <span
            class="w-5 h-5 rounded-full bg-[#C9A84C]/30 border border-[var(--bg)]"
          ></span>
          <span
            class="w-5 h-5 rounded-full bg-[#C9A84C]/20 border border-[var(--bg)]"
          ></span>
          <span
            class="w-5 h-5 rounded-full bg-[#C9A84C]/15 border border-[var(--bg)]"
          ></span>
        </span>
        <span>{i18n.hero.trustBadge}</span>
      </div>
    </div>

    <!-- CTAs stay English -->
    <div
      dir="ltr"
      class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8"
    >
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="hover:opacity-90 transition-opacity"
      >
        <img
          src="/google-play-badge.png"
          alt="Get it on Google Play"
          class="w-[220px] h-auto"
        />
      </a>
      <a
        href="/lectures/"
        class="w-full sm:w-auto border border-[var(--divider-lg)] font-semibold px-8 py-4 rounded-xl text-base hover:bg-surface-hover transition-colors"
      >
        Browse All Lectures →
      </a>
    </div>

    <!-- App feature chips stay English -->
    <p class="text-xs text-fg-3 mb-4 max-w-md mx-auto" dir="ltr">
      Features below are available in the <a
        href="/download/"
        class="text-[#C9A84C] hover:underline">Android app</a
      >.
    </p>
    <div
      dir="ltr"
      class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-xl mx-auto mt-2"
    >
      {
        [
          { icon: "⬇️", label: "Offline Downloads" },
          { icon: "🎵", label: "Background Playback" },
          { icon: "📊", label: "Progress Tracking" },
          { icon: "📚", label: "Study Mode" },
          { icon: "🌐", label: "Urdu Interface" },
          { icon: "📖", label: "In-App Book" },
        ].map(({ icon, label }) => (
          <div class="flex items-center gap-2.5 bg-surface border border-[var(--divider)] rounded-xl px-3 py-2.5 hover:border-[#C9A84C]/40 transition-colors">
            <span class="text-lg leading-none">{icon}</span>
            <span class="text-xs font-semibold text-fg">{label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Arabic series announcement -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-6 sm:py-8" dir="ltr">
    <a
      href="/arabic/"
      class="group relative block overflow-hidden rounded-3xl border border-[#C9A84C]/40 px-6 py-10 sm:px-10 sm:py-14 text-center transition-all duration-300 hover:border-[#C9A84C]/80"
      style="background: radial-gradient(125% 125% at 50% 0%, rgba(201,168,76,0.16) 0%, rgba(201,168,76,0.04) 42%, transparent 72%);"
    >
      <p class="text-[#C9A84C] text-[11px] sm:text-xs font-bold tracking-[0.25em] uppercase mb-6">
        New · The Arabic Series
      </p>
      <p
        class="text-[#C9A84C] font-bold leading-none mb-5 text-5xl sm:text-7xl"
        dir="rtl"
        lang="ar"
        style="font-family:'Noto Naskh Arabic',system-ui,sans-serif"
      >
        كتاب التوحيد
      </p>
      <h2 class="text-2xl sm:text-4xl font-bold mb-3 text-balance">
        Now hear it in the original Arabic
      </h2>
      <p class="text-fg-2 text-base sm:text-lg mb-8">
        91 audio duroos · Shaikh Salih al-Fawzan Hafizahullah · Free
      </p>
      <span class="inline-flex items-center gap-2 bg-[#C9A84C] text-black font-bold px-8 py-4 rounded-xl text-base group-hover:bg-[#D4B55C] transition-colors">
        Browse the Arabic Series →
      </span>
    </a>
  </section>

  <ContinueListening />

  <!-- Experience the App — stays English -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-16">
    <div class="text-center mb-10">
      <p
        class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-2"
      >
        Android App
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold mb-3">
        Continue Your Journey of Tawheed
      </h2>
      <p class="text-fg-2 text-sm sm:text-base max-w-md mx-auto">
        Listen anytime, continue where you left off, download lectures for
        offline study, and learn at your own pace.
      </p>
    </div>
    <div
      class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 sm:pb-0 sm:overflow-x-visible sm:justify-center -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-hide"
    >
      {
        [
          {
            src: "/app-screenshots/01-welcome.png",
            label: "Welcome",
            detail: "Free · No ads · No account",
          },
          {
            src: "/app-screenshots/02-choose-series.png",
            label: "Two Series, One App",
            detail: "Choose Urdu or Arabic",
          },
          {
            src: "/app-screenshots/03-welcome-ar.png",
            label: "Arabic Series",
            detail: "By Shaikh Salih al-Fawzan",
          },
          {
            src: "/app-screenshots/04-book-ar.png",
            label: "Read the Book",
            detail: "Full Arabic text, in-app",
          },
          {
            src: "/app-screenshots/06-lectures-ur.png",
            label: "Urdu Series",
            detail: "50 lectures across 15 classes",
          },
          {
            src: "/app-screenshots/08-player-ur.png",
            label: "Audio Player",
            detail: "Seek, speed control & more",
          },
        ].map(({ src, label, detail }) => (
          <div class="snap-center shrink-0 w-[188px] sm:w-[200px] text-center">
            <img
              src={src}
              alt={label}
              width="200"
              height="400"
              loading="lazy"
              class="w-full rounded-3xl"
            />
            <p class="text-sm font-semibold text-fg mt-3">{label}</p>
            <p class="text-xs text-fg-3 mt-0.5">{detail}</p>
          </div>
        ))
      }
    </div>
    <div class="text-center mt-10">
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="inline-block hover:opacity-90 transition-opacity"
      >
        <img
          src="/google-play-badge.png"
          alt="Get it on Google Play"
          class="w-[200px] h-auto mx-auto"
        />
      </a>
    </div>
  </section>

  <!-- Testimonials -->
  <section
    class="mx-auto max-w-3xl px-4 sm:px-6 py-10 border-t border-[var(--divider)]"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8"
      dir="rtl"
    >
      <h2 class="text-xl font-bold font-urdu">{locale === "ur" ? "سننے والوں کی رائے" : "What Listeners Say"}</h2>
      <div class="flex items-center gap-2 text-sm text-fg-2" dir="ltr">
        <span class="text-[#C9A84C] text-base tracking-tight">★★★★★</span>
        <span>5.0 · Google Play</span>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        [
          {
            name: "Kashif Husain",
            date: "April 2022",
            text: "Very handy and useful app for learning and understanding 'Kitaab at Tauheed' lectures. Easy to use without any hassles. May the developer of the app find it's 'ajr' as it's a 'Sadka e jaariya'.",
            helpful: 8,
          },
          {
            name: "Hasan Khan",
            date: "March 2022",
            text: "Jazakallah khair Sheikh. May Allah bless and reward you for your efforts. Every single Muslim must listen to these lectures once, thoroughly.",
            helpful: 8,
          },
          {
            name: "Mohsin Khan",
            date: "June 2021",
            text: "JazakAllah khair Shaikh. May Allah accept your efforts and keeps you in good health. Ameen ya Rabbul Alameen.",
            helpful: 14,
          },
          {
            name: "Sarfaraz Ahmad",
            date: "June 2024",
            text: "Masha'Allah bahut behtarin voice & cleared hai.",
            helpful: 2,
          },
        ].map(({ name, date, text, helpful }) => (
          <div class="bg-surface border border-[var(--divider)] rounded-xl p-5 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-[#C9A84C]/15 border border-[#C9A84C]/25 flex items-center justify-center shrink-0">
                <span class="text-[#C9A84C] font-bold text-base">
                  {name[0]}
                </span>
              </div>
              <div class="min-w-0">
                <p class="font-semibold truncate">{name}</p>
                <p class="text-[#C9A84C] text-sm tracking-tight mt-0.5">
                  ★★★★★
                </p>
              </div>
            </div>
            <p class="text-fg-2 text-base leading-relaxed flex-1">"{text}"</p>
            <p class="text-fg-4 text-xs">
              {helpful} people found this helpful · {date}
            </p>
          </div>
        ))
      }
    </div>
    <p class="text-center mt-6 text-xs text-fg-3">
      Reviews from Google Play Store
    </p>
  </section>

  <DailyBenefitCard {catalog} />

  <div class="text-center py-6">
    <a
      href="/lectures/urdu/"
      class="inline-block border border-[#C9A84C]/50 text-[#C9A84C] font-semibold px-8 py-3 rounded-xl text-base hover:bg-[#C9A84C]/10 transition-colors"
    >
      Browse all 15 classes →
    </a>
  </div>

  <!-- Web vs App -->
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h2 class="text-xl font-bold text-center mb-8 font-urdu">
      {locale === "ur" ? "ویب بمقابلہ اینڈرائیڈ ایپ" : "Web vs Android App"}
    </h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-surface border border-[var(--divider)] rounded-xl p-5" dir="rtl">
        <h3 class="font-semibold mb-3 text-fg-2 font-urdu">🌐 {locale === "ur" ? "براؤزر میں سنیں" : "Listen in Browser"}</h3>
        <ul class="text-sm space-y-2 text-fg-2 font-urdu">
          {locale === "ur" ? (
            <>
              <li>✓ تمام ۱۴۱ دروس اسٹریم کریں (اردو + عربی)</li>
              <li>✓ کوئی اکاؤنٹ نہیں</li>
              <li>✓ اسی براؤزر میں جاری رکھیں</li>
              <li class="text-fg-4">✗ انٹرنیٹ ضروری ہے</li>
              <li class="text-fg-4">✗ اسٹڈی موڈ نہیں</li>
              <li class="text-fg-4">✗ بیک گراؤنڈ پلے نہیں</li>
            </>
          ) : (
            <>
              <li>✓ Stream 141 lessons (Urdu + Arabic)</li>
              <li>✓ No account needed</li>
              <li>✓ Resume in this browser</li>
              <li class="text-fg-4">✗ Requires internet</li>
              <li class="text-fg-4">✗ No Study Mode</li>
              <li class="text-fg-4">✗ No background play</li>
            </>
          )}
        </ul>
      </div>
      <div class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-5 relative" dir="rtl">
        <span class="absolute -top-2.5 right-4 text-[10px] bg-[#C9A84C] text-black font-bold px-2 py-0.5 rounded-full font-urdu">
          {locale === "ur" ? "تجویز کردہ" : "RECOMMENDED"}
        </span>
        <h3 class="font-semibold mb-3 text-[#C9A84C] font-urdu">📱 {locale === "ur" ? "اینڈرائیڈ ایپ" : "Android App"}</h3>
        <ul class="text-sm space-y-2 font-urdu">
          {locale === "ur" ? (
            <>
              <li>✓ <strong>۵۰ اردو + ۹۱ عربی دروس</strong></li>
              <li>✓ <strong>آف لائن ڈاؤنلوڈ</strong></li>
              <li>✓ <strong>پیشرفت ٹریکنگ</strong></li>
              <li>✓ <strong>اسٹڈی موڈ</strong></li>
              <li>✓ <strong>بیک گراؤنڈ پلے بیک</strong></li>
              <li>✓ <strong>اردو اور عربی</strong></li>
            </>
          ) : (
            <>
              <li>✓ <strong>50 Urdu + 91 Arabic Lessons</strong></li>
              <li>✓ <strong>Offline Downloads</strong></li>
              <li>✓ <strong>Progress Tracking</strong></li>
              <li>✓ <strong>Study Mode</strong></li>
              <li>✓ <strong>Background Playback</strong></li>
              <li>✓ <strong>Arabic & Urdu</strong></li>
            </>
          )}
        </ul>
      </div>
    </div>
    <div
      class="text-center mt-6 flex flex-col sm:flex-row gap-3 justify-center"
    >
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="inline-block bg-[#C9A84C] text-black font-bold px-8 py-3 rounded-xl text-sm hover:bg-[#D4B55C] transition-colors"
      >
        Download Free — Google Play
      </a>
      <a
        href={`/${locale}/download/`}
        class="inline-block border border-[#C9A84C]/40 text-[#C9A84C] font-semibold px-8 py-3 rounded-xl text-sm hover:bg-[#C9A84C]/10 transition-colors"
      >
        See app features →
      </a>
    </div>
  </section>

  <!-- About snippet — translated -->
  <section
    class="mx-auto max-w-3xl px-4 py-8 border-t border-[var(--divider)]"
    dir="rtl"
  >
    <h2 class="text-xl font-bold mb-4 font-urdu">{i18n.index.aboutTitle}</h2>
    <p class="text-fg-2 leading-relaxed mb-3 font-urdu">
      <strong class="text-fg">کتاب التوحید</strong>{" "}
      {
        tx(i18n.index.aboutBody, {
          count: urduCount,
          hours: totalHours,
        })
      }
    </p>
    <ul class="text-fg-2 text-sm space-y-2 mb-4 font-urdu">
      <li>
        <strong class="text-fg">
          {locale === "ur" ? "اردو سلسلہ" : "Urdu series"}</strong
        > — {urduCount} {locale === "ur" ? "دروس · شیخ عبداللہ ناصر رحمانی حفظہ اللہ" : "lectures · by Shaikh Abdullah Nasir Rahmani"}.{" "}
        <a href="/lectures/urdu/" class="text-[#C9A84C] hover:underline">
          {locale === "ur" ? "براؤز کریں ←" : "Browse →"}</a
        >
      </li>
      <li>
        <strong class="text-fg">
          {locale === "ur" ? "عربی سلسلہ" : "Arabic series"}</strong
        > — {arabicCount} {locale === "ur" ? "دروس · شیخ صالح الفوزان حفظہ اللہ" : "duroos · by Shaikh Ṣāliḥ al-Fawzān"}.{" "}
        <a href="/arabic/" class="text-[#C9A84C] hover:underline">
          {locale === "ur" ? "براؤز کریں ←" : "Browse →"}</a
        >
      </li>
    </ul>
    <a
      href={`/${locale}/about/`}
      class="text-[#C9A84C] text-sm hover:underline font-urdu"
    >
      {i18n.index.readMore}
    </a>
  </section>
</Layout>

<style>
  .font-urdu {
    font-family: "Noto Naskh Arabic", "Segoe UI", system-ui, sans-serif;
    line-height: 1.9;
  }
</style>
