---
import Layout from "../../layouts/Layout.astro";
import WhatsNew from "../../components/WhatsNew.astro";
import AppDownloadBadge from "../../components/AppDownloadBadge.astro";
import { getCatalog, getArabicCatalog, getAppConfig, en, playStoreUrl, BOOK_COVER_SRC } from "../../lib/catalog";
import { t, tx, getLocalePaths } from "../../lib/i18n";

export function getStaticPaths() {
  return getLocalePaths();
}

const { locale } = Astro.params;
const [catalog, arabicCatalog, appConfig] = await Promise.all([getCatalog(), getArabicCatalog(), getAppConfig()]);
const storeUrl = playStoreUrl(appConfig);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const totalCount = urduCount + arabicCount;
const i18n = t(locale);

const featureTitles = [
  "Two Complete Series",
  "Offline Downloads",
  "Study Mode",
  "Read the Book",
  "Progress Tracking",
  "Background Playback",
];
const featureIcons = ["📖", "⬇️", "📚", "📕", "📊", "🎵"];

const screenshots = [
  { src: "/app-screenshots/01-welcome.png", alt: "Welcome — Sharah Kitab al-Tawheed" },
  { src: "/app-screenshots/02-choose-series.png", alt: "Choose series — Urdu or Arabic" },
  { src: "/app-screenshots/03-welcome-ar.png", alt: "Arabic series welcome" },
  { src: "/app-screenshots/04-book-ar.png", alt: "Arabic Book tab — full text in-app" },
  { src: "/app-screenshots/05-player-ar.png", alt: "Arabic audio player" },
  { src: "/app-screenshots/06-lectures-ur.png", alt: "Urdu lecture list by class" },
  { src: "/app-screenshots/07-study-ur.png", alt: "Study Mode" },
  { src: "/app-screenshots/08-player-ur.png", alt: "Audio player" },
];
---

<Layout
  title={locale === "ur" ? "ایپ ڈاؤنلوڈ کریں — شرح کتاب التوحید | مفت اینڈرائیڈ" : "Download App — Sharah Kitab al-Tawheed | Free Android"}
  description={locale === "ur" ? `کتاب التوحید کی مفت اینڈرائیڈ ایپ ڈاؤنلوڈ کریں — دو سلسلوں میں ${totalCount} آڈیو دروس (${urduCount} اردو + ${arabicCount} عربی)، آف لائن موڈ، اسٹڈی موڈ۔` : `Download the free Android app for Kitab al-Tawheed — ${totalCount} audio lessons across two series (${urduCount} Urdu + ${arabicCount} Arabic), offline mode, Study Mode.`}
  {appConfig}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0" dir="rtl">
    <nav class="text-xs text-fg-3 mb-6" dir="ltr">
      <a href={`/${locale}/`} class="hover:text-[#C9A84C]">Home</a> → Download App
    </nav>

    <div class="flex flex-col md:flex-row gap-8 items-start mb-12">
      <img
        src={BOOK_COVER_SRC}
        alt={en(catalog.book.title)}
        width="200"
        height="200"
        class="w-40 md:w-48 rounded-xl border border-[#C9A84C]/30 shadow-lg shrink-0 mx-auto md:mx-0"
        loading="eager"
      />
      <div class="flex-1 text-center md:text-right">
        <h1 class="text-3xl font-bold mb-2 font-urdu">{i18n.download.pageTitle}</h1>
        <p class="text-[#C9A84C] text-lg mb-1" dir="rtl" lang="ur">{catalog.book.title.ur ?? "شرح کتاب التوحید"}</p>
        <p class="text-fg-2 mb-3 font-urdu">
          {totalCount} {locale === "ur" ? "دروس" : "lessons"} · {locale === "ur" ? "دو سلسلے (اردو اور عربی)" : "Two series (Urdu & Arabic)"}
        </p>
        <div dir="ltr" class="flex flex-col items-center md:items-start gap-2">
          <AppDownloadBadge href={storeUrl} eager />
          <p class="text-xs text-fg-3 font-urdu">
            {i18n.download.streamNote}{" "}
            <a href="/lectures/" class="text-[#C9A84C] hover:underline">
              {locale === "ur" ? "آن لائن دروس براؤز کریں" : "Browse lectures on the web"}
            </a>
          </p>
        </div>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-6 font-urdu">{i18n.download.whyTitle}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {i18n.download.features.map(({ desc }, idx) => (
          <div class="bg-surface border border-[var(--divider)] rounded-xl p-4">
            <!-- Feature title stays English per hybrid model -->
            <p class="text-lg mb-1">{featureIcons[idx]} <span class="font-semibold">{featureTitles[idx]}</span></p>
            <p class="text-sm text-fg-2 font-urdu">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-6 font-urdu">{i18n.download.previewTitle}</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {screenshots.map(({ src, alt }) => (
          <img
            src={src}
            alt={alt}
            width="270"
            height="540"
            class="w-full rounded-xl border border-[var(--divider)] bg-surface"
            loading="lazy"
          />
        ))}
      </div>
    </section>

    <WhatsNew
      title={i18n.download.whatsNewTitle}
      allReleasesLabel={i18n.download.allReleases}
    />

    <section class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-6 text-center">
      <p class="font-semibold mb-2 font-urdu">{i18n.download.ctaFree}</p>
      <p class="text-sm text-fg-2 mb-4 font-urdu">
        {tx(i18n.download.ctaDesc, { appName: appConfig.about.appName, count: totalCount })}
      </p>
      <div class="flex flex-col items-center gap-3">
        <AppDownloadBadge href={storeUrl} />
      </div>
    </section>
  </div>
</Layout>

<style>
  .font-urdu {
    font-family: "Noto Naskh Arabic", "Segoe UI", system-ui, sans-serif;
    line-height: 1.9;
  }
</style>
