---
import Layout from "../../layouts/Layout.astro";
import { getCatalog, getArabicCatalog, getAppConfig, en, playStoreUrl } from "../../lib/catalog";
import { t, tx, getLocalePaths } from "../../lib/i18n";

export function getStaticPaths() {
  return getLocalePaths();
}

const { locale } = Astro.params;
const [catalog, arabicCatalog, appConfig] = await Promise.all([getCatalog(), getArabicCatalog(), getAppConfig()]);
const storeUrl = playStoreUrl(appConfig);
const totalHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const arabicCount = arabicCatalog.book.lectureCount;
const i18n = t(locale);
---

<Layout
  title={locale === "ur" ? "کتاب التوحید کے بارے میں" : "About — Kitab al-Tawheed"}
  description={locale === "ur" ? "کتاب التوحید کے آڈیو سلسلوں کے بارے میں — شیخ عبداللہ ناصر رحمانی کے اردو دروس اور شیخ صالح الفوزان کے عربی دروس۔" : "About the Kitab al-Tawheed audio series by Shaikh Abdullah Nasir Rahmani (Urdu) and Shaikh Salih al-Fawzan (Arabic)."}
  {appConfig}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-10 min-w-0" dir="rtl">
    <nav class="text-xs text-fg-3 mb-6" dir="ltr">
      <a href={`/${locale}/`} class="hover:text-[#C9A84C]">Home</a> → About
    </nav>

    <h1 class="text-3xl font-bold mb-8 font-urdu">{i18n.about.pageTitle}</h1>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3 font-urdu">{i18n.about.kitab.title}</h2>
      <p class="text-fg-2 leading-relaxed mb-3 font-urdu">
        <strong class="text-fg">{i18n.about.kitab.title}</strong>{" "}
        {i18n.about.kitab.p1}
      </p>
      <p class="text-fg-2 leading-relaxed mb-3 font-urdu">{i18n.about.kitab.p2}</p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3 font-urdu">{i18n.about.speaker.title}</h2>
      <p class="text-fg-2 leading-relaxed mb-3 font-urdu">
        <strong class="text-fg">{locale === "ur" ? "فضیلت شیخ عبداللہ ناصر رحمانی حفظہ اللہ" : en(catalog.book.speaker)}</strong>{" "}
        {i18n.about.speaker.p1}
      </p>
      <p class="text-fg-2 leading-relaxed font-urdu">
        {tx(i18n.about.speaker.p2, { count: catalog.book.lectureCount, hours: totalHours })}
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3 font-urdu">{i18n.about.arabic.title}</h2>
      <p class="text-fg-2 leading-relaxed mb-3 font-urdu">{i18n.about.arabic.p1}</p>
      <p class="text-fg-2 leading-relaxed font-urdu">
        {tx(i18n.about.arabic.p2, { count: arabicCount })}{" "}
        <a href="/arabic/" class="text-[#C9A84C] hover:underline" dir="ltr">/arabic/</a>
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3 font-urdu">{i18n.about.app.title}</h2>
      <p class="text-fg-2 leading-relaxed mb-4 font-urdu">
        <strong class="text-fg">{locale === "ur" ? "کتاب التوحید اینڈرائیڈ ایپ" : "Kitab al-Tawheed Android app"}</strong>{" "}
        {i18n.about.app.p1}
      </p>
      <div dir="ltr" class="flex flex-wrap gap-3">
        <a href={storeUrl} target="_blank" rel="noopener" class="inline-block bg-[#C9A84C] text-black font-bold px-6 py-3 rounded-xl text-sm hover:bg-[#D4B55C] transition-colors">
          Download Free on Google Play
        </a>
        <a href={`/${locale}/download/`} class="block mt-1 text-[#C9A84C] text-sm hover:underline self-center">
          App features & screenshots →
        </a>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">Al Marfa Duroos</h2>
      <p class="text-fg-2 leading-relaxed mb-3 font-urdu">
کتاب التوحید <a href="https://www.youtube.com/@almarfaduroos" target="_blank" rel="noopener" class="text-[#C9A84C] hover:underline font-semibold">Al Marfa Duroos</a> کا ایک کورس ہے — مفت اردو اور عربی اسلامی آڈیو دروس، جو کلاسیکی علمی ورثے کو دنیا بھر کے مسلمانوں تک بغیر کسی قیمت یا اکاؤنٹ کے پہنچانے کے لیے بنائے گئے ہیں۔
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3 font-urdu">{i18n.about.contact.title}</h2>
      <p class="text-fg-2 font-urdu">
        {i18n.about.contact.text}
        <a href="mailto:hello@almarfa.co" class="text-[#C9A84C] hover:underline mr-1" dir="ltr">
          hello@almarfa.co
        </a>
      </p>
    </section>
  </div>
</Layout>

<style>
  .font-urdu {
    font-family: "Noto Naskh Arabic", "Segoe UI", system-ui, sans-serif;
    line-height: 1.9;
  }
</style>
