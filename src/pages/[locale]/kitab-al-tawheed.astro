---
import Layout from "../../layouts/Layout.astro";
import { getCatalog, getArabicCatalog, getAppConfig } from "../../lib/catalog";
import { t, tx, getLocalePaths } from "../../lib/i18n";

export function getStaticPaths() {
  return getLocalePaths();
}

const { locale } = Astro.params;
const [catalog, arabicCatalog, appConfig] = await Promise.all([getCatalog(), getArabicCatalog(), getAppConfig()]);
const arabicCount = arabicCatalog.book.lectureCount;
const i18n = t(locale);
---

<Layout
  title={locale === "ur" ? "کتاب التوحید کیا ہے؟ — خلاصہ اور مفت اردو و عربی شرح" : "What is Kitab al-Tawheed? — Summary & Free Urdu + Arabic Sharah"}
  description={locale === "ur" ? "کتاب التوحید کیا ہے، کس نے لکھی، اور مفت سنیں: شیخ عبداللہ ناصر رحمانی کی اردو شرح اور شیخ صالح الفوزان کی عربی دروس۔" : "Learn what Kitab al-Tawheed is and listen free: the Urdu sharah by Shaikh Abdullah Nasir Rahmani and the Arabic duroos by Shaikh Salih al-Fawzan."}
  {appConfig}
  faqItems={i18n.kitab.faq}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-10 min-w-0" dir="rtl" data-pagefind-body>
    <nav class="text-xs text-fg-3 mb-6" dir="ltr">
      <a href={`/${locale}/`} class="hover:text-[#C9A84C]">Home</a> → Kitab al-Tawheed
    </nav>

    <h1 class="text-3xl font-bold mb-4 font-urdu">{i18n.kitab.pageTitle}</h1>
    <p class="text-[#C9A84C] text-xl mb-6" dir="rtl" lang="ar">كتاب التوحيد</p>

    <p class="text-fg-2 leading-relaxed mb-4 font-urdu">{i18n.kitab.p1}</p>
    <p class="text-fg-2 leading-relaxed mb-4 font-urdu">
      <strong class="text-fg">{locale === "ur" ? "امام محمد بن عبدالوہاب رحمہ اللہ" : "Imam Muhammad ibn Abd al-Wahhab Rahimahullah"}</strong>{" "}
      {i18n.kitab.p2}
    </p>

    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      <section class="bg-surface border border-[var(--divider)] rounded-xl p-5">
        <h2 class="text-lg font-bold text-[#C9A84C] mb-2 font-urdu">{locale === "ur" ? "اردو شرح" : "Urdu Sharah"}</h2>
        <p class="text-sm text-fg-2 mb-4 font-urdu">
          <strong class="text-fg">{locale === "ur" ? "شیخ عبداللہ ناصر رحمانی" : "Shaikh Abdullah Nasir Rahmani"}</strong>{" "}
          {tx(i18n.kitab.freeSection.description, { count: catalog.book.lectureCount })}
        </p>
        <div dir="ltr" class="flex flex-wrap gap-3">
          <a href="/lectures/urdu/" class="bg-[#C9A84C] text-black font-bold px-5 py-2.5 rounded-lg text-sm hover:bg-[#D4B55C]">
            Browse Urdu series
          </a>
        </div>
      </section>

      <section class="bg-surface border border-[var(--divider)] rounded-xl p-5">
        <h2 class="text-lg font-bold text-[#C9A84C] mb-2 font-urdu">{locale === "ur" ? "عربی دروس" : "Arabic Duroos"}</h2>
        <p class="text-sm text-fg-2 mb-4 font-urdu">
          <strong class="text-fg">{locale === "ur" ? "شیخ صالح الفوزان" : "Shaikh Salih al-Fawzan"}</strong>{" "}
          {locale === "ur"
            ? `کتاب التوحید کی شرح ${arabicCount} عربی آڈیو دروس میں بیان کرتے ہیں۔`
            : `explains Kitab at-Tawheed in ${arabicCount} Arabic audio duroos.`}
        </p>
        <div dir="ltr" class="flex flex-wrap gap-3">
          <a href="/arabic/" class="bg-[#C9A84C] text-black font-bold px-5 py-2.5 rounded-lg text-sm hover:bg-[#D4B55C]">
            Browse Arabic series
          </a>
        </div>
      </section>
    </div>

    <section>
      <h2 class="text-xl font-bold mb-4 font-urdu">
        {locale === "ur" ? "اکثر پوچھے گئے سوالات" : "Frequently Asked Questions"}
      </h2>
      <div class="space-y-4">
        {i18n.kitab.faq.map(({ question, answer }) => (
          <details class="bg-surface border border-[var(--divider)] rounded-xl overflow-hidden group">
            <summary class="px-5 py-4 cursor-pointer font-semibold list-none flex items-center justify-between gap-3 hover:bg-surface-hover transition-colors font-urdu">
              <span>{question}</span>
              <span class="text-fg-3 text-lg shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="px-5 pb-4 text-fg-2 text-sm leading-relaxed font-urdu">
              {tx(answer, { count: catalog.book.lectureCount, arabicCount })}
            </p>
          </details>
        ))}
      </div>
    </section>
  </article>
</Layout>

<style>
  .font-urdu {
    font-family: "Noto Naskh Arabic", "Segoe UI", system-ui, sans-serif;
    line-height: 1.9;
  }
</style>
