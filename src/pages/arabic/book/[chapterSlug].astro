---
import Layout from "../../../layouts/Layout.astro";
import {
  getArabicBook,
  getAppConfig,
  bookChapterHtml,
  playStoreUrl,
  bookCoverOgUrl,
  SITE_URL,
} from "../../../lib/catalog";
import { arUI } from "../../../i18n/ar";

export async function getStaticPaths() {
  const { chapters } = getArabicBook();
  return chapters.map((chapter) => ({
    params: { chapterSlug: chapter.id },
    props: { chapterId: chapter.id },
  }));
}

const { chapterId } = Astro.props;
const [{ book, chapters }, appConfig] = await Promise.all([
  Promise.resolve(getArabicBook()),
  getAppConfig(),
]);
const storeUrl = playStoreUrl(appConfig);
const sorted = chapters.slice().sort((a, b) => a.number - b.number);
const idx = sorted.findIndex((c) => c.id === chapterId);
const chapter = sorted[idx];
const prev = sorted[idx - 1];
const next = sorted[idx + 1];
// Chapters are numbered sequentially from the first entry: "كتاب التوحيد" is 1,
// then the babs 2…67 — a running 1-based position over the whole book.
const position = idx + 1;
const total = sorted.length;
const chapterPath = `/arabic/book/${chapter.id}/`;
const coverUrl = bookCoverOgUrl();

const bodyHtml = bookChapterHtml(chapter.text);
const isOpening = chapter.number === 0;

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: chapter.title,
  inLanguage: "ar",
  image: coverUrl,
  author: { "@type": "Person", name: book.author },
  publisher: { "@type": "Organization", name: "Al Marfa Duroos" },
  isPartOf: {
    "@type": "Book",
    name: book.title,
    url: `${SITE_URL}/arabic/book/`,
  },
};

const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: book.title, item: `${SITE_URL}/arabic/book/` },
    { "@type": "ListItem", position: 3, name: chapter.title, item: `${SITE_URL}${chapterPath}` },
  ],
};

const ogTitle = isOpening
  ? "كتاب التوحيد — المتن الكامل"
  : `${chapter.title} — كتاب التوحيد`;
const ogDescription = `${chapter.title} من كتاب التوحيد لمحمد بن عبد الوهاب. النص الكامل بالعربية.`;
---

<Layout
  title={ogTitle}
  description={ogDescription}
  {appConfig}
  ogImage={coverUrl}
  ogImageAlt={`${chapter.title} — كتاب التوحيد`}
  ogType="article"
  lang="ar"
  dir="rtl"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdArticle)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdBreadcrumb)}
    slot="head"
  />

  <article
    class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0 font-arabic"
    dir="rtl"
    lang="ar"
    data-pagefind-body
  >
    <!-- Breadcrumb -->
    <nav class="text-xs text-fg-3 mb-6 leading-relaxed" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#C9A84C]" dir="ltr">Home</a>
      <span class="mx-1">←</span>
      <a href="/arabic/book/" class="hover:text-[#C9A84C]">{arUI.book.backToBook}</a>
      <span class="mx-1">←</span>
      <span class="text-fg-2">{chapter.title}</span>
    </nav>

    <!-- Title -->
    <div class="mb-5">
      <p class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-1" dir="ltr">
        {arUI.book.chapter} {position} / {total}
      </p>
      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold leading-snug text-balance">
        {chapter.title}
      </h1>
    </div>

    <!-- Color-key legend + font-size control -->
    <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-[var(--divider)]">
      <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-fg-3">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full" style="background: var(--book-verse)"></span>
          {arUI.book.keyVerse}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full" style="background: var(--book-hadith)"></span>
          {arUI.book.keyHadith}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full" style="background: var(--book-citation)"></span>
          {arUI.book.keyCitation}
        </span>
      </div>
      <div
        class="flex items-center gap-1.5 shrink-0"
        dir="ltr"
        role="group"
        aria-label={arUI.book.textSize}
      >
        <button
          id="font-dec"
          type="button"
          aria-label={arUI.book.decreaseText}
          title={arUI.book.decreaseText}
          class="inline-flex items-center gap-0.5 h-9 px-2.5 rounded-lg border border-[var(--divider)] text-fg-2 hover:text-fg hover:border-[var(--divider-md)] transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span class="text-xs font-bold" aria-hidden="true">A</span>
          <span class="text-sm leading-none" aria-hidden="true">−</span>
        </button>
        <button
          id="font-inc"
          type="button"
          aria-label={arUI.book.increaseText}
          title={arUI.book.increaseText}
          class="inline-flex items-center gap-0.5 h-9 px-2.5 rounded-lg border border-[var(--divider)] text-fg-2 hover:text-fg hover:border-[var(--divider-md)] transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span class="text-base font-bold" aria-hidden="true">A</span>
          <span class="text-sm leading-none" aria-hidden="true">+</span>
        </button>
      </div>
    </div>

    <!-- Matn -->
    <div class="book-matn text-fg" set:html={bodyHtml} />

    <!-- Get App CTA -->
    <div class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-4 my-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-[#C9A84C]">{arUI.player.continueOnApp}</p>
        <p class="text-xs text-fg-2">{arUI.player.offlineFeatures}</p>
      </div>
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="shrink-0 w-full sm:w-auto text-center bg-[#C9A84C] text-black font-bold px-4 py-3 sm:py-2 rounded-lg text-sm sm:text-xs hover:bg-[#D4B55C] transition-colors min-h-[44px] sm:min-h-0 flex items-center justify-center"
      >
        {arUI.player.getApp}
      </a>
    </div>

    <!-- Prev / Next -->
    <div class="flex flex-col sm:flex-row gap-3 mb-8">
      {
        next && (
          <a
            href={`/arabic/book/${next.id}/`}
            class="flex-1 bg-surface border border-[var(--divider)] rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all text-right min-w-0"
          >
            <p class="text-xs text-fg-3 mb-1">{arUI.book.nextChapter}</p>
            <p class="text-sm font-semibold truncate">{next.title}</p>
          </a>
        )
      }
      {
        prev && (
          <a
            href={`/arabic/book/${prev.id}/`}
            class="flex-1 bg-surface border border-[var(--divider)] rounded-xl p-3 hover:border-[#C9A84C]/40 transition-all text-left min-w-0"
          >
            <p class="text-xs text-fg-3 mb-1">{arUI.book.prevChapter}</p>
            <p class="text-sm font-semibold truncate">{prev.title}</p>
          </a>
        )
      }
    </div>

    <!-- All chapters -->
    <div>
      <h2 class="text-sm font-bold text-fg-2 uppercase tracking-widest mb-3">
        {arUI.book.chapters}
      </h2>
      <div class="space-y-1.5">
        {
          sorted.map((c, i) => (
            <a
              href={`/arabic/book/${c.id}/`}
              class={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-all ${c.id === chapter.id ? "bg-[#C9A84C]/15 border border-[#C9A84C]/30 text-[#C9A84C]" : "hover:bg-surface-hover text-fg-2"}`}
            >
              <span class="text-xs font-bold shrink-0 w-6 text-left" dir="ltr">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="block min-w-0 truncate">{c.title}</span>
            </a>
          ))
        }
      </div>
    </div>

    <script is:inline>
      (function () {
        var MIN = 14, MAX = 32, STEP = 2, DEFAULT = 22;
        var root = document.documentElement;
        var dec = document.getElementById("font-dec");
        var inc = document.getElementById("font-inc");
        if (!dec || !inc) return;
        // Per-view only — intentionally NOT persisted, so a refresh resets it.
        var size = DEFAULT;
        function apply(next) {
          size = Math.max(MIN, Math.min(MAX, next));
          root.style.setProperty("--matn-font", size + "px");
          dec.disabled = size <= MIN;
          inc.disabled = size >= MAX;
        }
        apply(size);
        dec.addEventListener("click", function () { apply(size - STEP); });
        inc.addEventListener("click", function () { apply(size + STEP); });
      })();
    </script>
  </article>
</Layout>

<style>
  .font-arabic {
    font-family: "Noto Naskh Arabic", "Segoe UI", system-ui, sans-serif;
    line-height: 1.8;
  }
  .book-matn {
    font-size: var(--matn-font, 22px);
    line-height: 2;
  }
  .book-matn :global(p) {
    margin-bottom: 1rem;
  }
  .book-matn :global(.ayah) {
    color: var(--book-verse);
    font-weight: 500;
  }
  .book-matn :global(.hadith) {
    color: var(--book-hadith);
  }
  .book-matn :global(.citation) {
    color: var(--book-citation);
    font-size: 0.9em;
  }
</style>
