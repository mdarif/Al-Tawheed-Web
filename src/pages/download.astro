---
import Layout from "../layouts/Layout.astro";
import WhatsNew from "../components/WhatsNew.astro";
import {
  getCatalog,
  getArabicCatalog,
  getAppConfig,
  en,
  playStoreUrl,
  bookCoverSrc,
} from "../lib/catalog";

const [catalog, arabicCatalog, appConfig] = await Promise.all([
  getCatalog(),
  getArabicCatalog(),
  getAppConfig(),
]);
const storeUrl = playStoreUrl(appConfig);
const coverSrc = bookCoverSrc(catalog.book);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const totalCount = urduCount + arabicCount;

const screenshots = [
  {
    src: "/app-screenshots/01-welcome.png",
    alt: "Welcome — Sharah Kitab al-Tawheed",
  },
  {
    src: "/app-screenshots/02-choose-series.png",
    alt: "Choose series — Urdu or Arabic",
  },
  {
    src: "/app-screenshots/03-welcome-ar.png",
    alt: "Arabic series welcome — Shaikh Salih al-Fawzan",
  },
  {
    src: "/app-screenshots/04-book-ar.png",
    alt: "Arabic Book tab — full Kitab at-Tawheed text in-app",
  },
  {
    src: "/app-screenshots/05-player-ar.png",
    alt: "Arabic audio player — now playing",
  },
  {
    src: "/app-screenshots/06-lectures-ur.png",
    alt: "Urdu lecture list by class with Study tab",
  },
  {
    src: "/app-screenshots/07-study-ur.png",
    alt: "Study Mode — work through each class in order",
  },
  {
    src: "/app-screenshots/08-player-ur.png",
    alt: "Audio player with seek and speed",
  },
];

const features = [
  {
    icon: "📖",
    title: "Two Complete Series",
    desc: `The ${urduCount}-lecture Urdu series by Shaikh Abdullah Nasir Rahmani and the ${arabicCount}-duroos Arabic series by Shaikh Salih al-Fawzan — switch anytime.`,
  },
  {
    icon: "⬇️",
    title: "Offline Downloads",
    desc: "Save lessons for travel or poor connectivity. Wi-Fi-only mode and one-tap cleanup keep storage tidy.",
  },
  {
    icon: "📚",
    title: "Study Mode",
    desc: "Dedicated Study tab for the Urdu series — work through each class in order with completion tracking.",
  },
  {
    icon: "📕",
    title: "Read the Book",
    desc: "The Arabic series includes an in-app Book tab with the full Kitab at-Tawheed text.",
  },
  {
    icon: "📊",
    title: "Progress Tracking",
    desc: "Resume exactly where you stopped on each lesson.",
  },
  {
    icon: "🎵",
    title: "Background Playback",
    desc: "Listen while using other apps or with screen off, at 0.75×–2× speed.",
  },
];
---

<Layout
  title="Download App — Kitab al-Tawheed | Free Android"
  description={`Download the free Android app for Kitab al-Tawheed — ${totalCount} audio lessons across two series (${urduCount} Urdu + ${arabicCount} Arabic), offline mode, Study Mode, and progress tracking.`}
  {appConfig}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> → Download App
    </nav>

    <div class="flex flex-col md:flex-row gap-8 items-start mb-12">
      <img
        src={coverSrc}
        alt={en(catalog.book.title)}
        width="200"
        height="105"
        class="w-40 md:w-48 rounded-xl border border-[#C9A84C]/30 shadow-lg shrink-0 mx-auto md:mx-0"
        loading="eager"
      />
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-3xl font-bold mb-2">
          Kitab al-Tawheed Mobile App
        </h1>
        <p class="text-[#C9A84C] text-lg mb-1" dir="rtl" lang="ur">
          {catalog.book.title.ur ?? "شرح کتاب التوحید"}
        </p>
        <p class="text-fg-2 mb-3">
          {totalCount} Lessons · Two Series (Urdu & Arabic) · Free
        </p>
        <a
          href={storeUrl}
          target="_blank"
          rel="noopener"
          class="inline-block hover:opacity-90 transition-opacity"
        >
          <img
            src="/google-play-badge.png"
            alt="Get it on Google Play"
            class="w-[220px] h-auto"
          />
        </a>
        <p class="text-xs text-fg-3 mt-3">
          Prefer streaming? <a
            href="/lectures/"
            class="text-[#C9A84C] hover:underline">Browse lectures on the web</a
          >
        </p>
      </div>
    </div>

    <section class="mb-12">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-6">Why Use The App?</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          features.map(({ icon, title, desc }) => (
            <div class="bg-surface border border-[var(--divider)] rounded-xl p-4">
              <p class="text-lg mb-1">
                {icon} <span class="font-semibold">{title}</span>
              </p>
              <p class="text-sm text-fg-2">{desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-6">Mobile App Preview</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          screenshots.map(({ src, alt }) => (
            <img
              src={src}
              alt={alt}
              width="270"
              height="540"
              class="w-full rounded-xl border border-[var(--divider)] bg-surface"
              loading="lazy"
            />
          ))
        }
      </div>
    </section>

    <WhatsNew />

    <section
      class="bg-surface-gold border border-[#C9A84C]/30 rounded-xl p-6 text-center"
    >
      <p class="font-semibold mb-2">Free · No ads · No account</p>
      <p class="text-sm text-fg-2 mb-4">
        {appConfig.about.appName} — {totalCount} free audio lessons across two
        series.
      </p>
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="inline-block hover:opacity-90 transition-opacity"
      >
        <img
          src="/google-play-badge.png"
          alt="Get it on Google Play"
          class="w-[200px] h-auto mx-auto"
        />
      </a>
    </section>
  </div>
</Layout>
