---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="You're offline — Sharah Kitab at-Tawheed"
  description="You're offline. Pages you've already visited are still available."
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="mx-auto max-w-lg px-4 py-16 sm:py-24 text-center min-w-0">
    <p class="text-[#C9A84C] text-sm font-semibold uppercase tracking-widest mb-3">
      Offline
    </p>
    <h1 class="text-2xl sm:text-3xl font-bold mb-3">You're offline</h1>
    <p class="text-fg-2 text-sm mb-8">
      This page hasn't been saved for offline viewing. Pages you've already
      visited are still available below.
    </p>
    <nav class="flex flex-col sm:flex-row gap-3 justify-center text-sm">
      <a
        href="/"
        class="bg-[#C9A84C] text-black font-semibold px-6 py-3 rounded-xl hover:bg-[#D4B55C] transition-colors"
      >
        Home
      </a>
      <a
        href="/lectures/"
        class="border border-[var(--divider-lg)] font-semibold px-6 py-3 rounded-xl hover:bg-surface-hover transition-colors"
      >
        Browse lectures
      </a>
    </nav>
  </section>
</Layout>
