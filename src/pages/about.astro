---
import Layout from "../layouts/Layout.astro";
import { getCatalog, getArabicCatalog, getAppConfig, playStoreUrl } from "../lib/catalog";

const [catalog, arabicCatalog, appConfig] = await Promise.all([
  getCatalog(),
  getArabicCatalog(),
  getAppConfig(),
]);
const storeUrl = playStoreUrl(appConfig);
const totalHours = Math.floor(catalog.book.totalDurationSeconds / 3600);
const urduCount = catalog.book.lectureCount;
const arabicCount = arabicCatalog.book.lectureCount;
const totalCount = urduCount + arabicCount;
---

<Layout
  title="About — Kitab al-Tawheed Audio Series"
  {appConfig}
  description={`About the Kitab al-Tawheed audio series — ${urduCount} Urdu lectures by Shaikh Abdullah Nasir Rahmani and ${arabicCount} Arabic duroos by Shaikh Salih al-Fawzan on Islamic monotheism.`}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-8 sm:py-10 min-w-0">
    <nav class="text-xs text-fg-3 mb-6">
      <a href="/" class="hover:text-[#C9A84C]">Home</a> → About
    </nav>

    <h1 class="text-3xl font-bold mb-8">About These Series</h1>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">Kitab al-Tawheed</h2>
      <p class="text-fg-2 leading-relaxed mb-3">
        <strong class="text-fg">Kitab al-Tawheed</strong> (كتاب التوحيد — "The Book
        of Islamic Monotheism") is one of the most important works in Islamic theology,
        written by <strong class="text-fg"
          >Shaykh ul Islam al-Imam Muhammad ibn Abd al-Wahhab ibn Sulayman
          al-Tamimi Al Najdi Rahimahullah</strong
        > (1703–1792). It is widely studied in Islamic institutes and seminaries worldwide.
      </p>
      <p class="text-fg-2 leading-relaxed mb-3">
        The book covers the foundation of Islamic faith — Tawheed (the oneness
        of Allah) — drawing exclusively from the Quran and authentic Sunnah. It
        addresses the three categories of Tawheed, the dangers of shirk
        (associating partners with Allah), and the obligations upon every Muslim
        to understand and implement Tawheed in their daily lives.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">
        The Urdu Series
      </h2>
      <p class="text-fg-2 leading-relaxed mb-3">
        <strong class="text-fg"
          >Fazilat Shaikh Abdullah Nasir Rahmani Hafizahullah</strong
        > is a respected Islamic scholar, known for his clear and accessible Urdu
        explanations of classical Islamic texts. His teaching style — rooted in evidence
        from Quran and Sunnah — has benefited hundreds of thousands of Muslims across
        South Asia and beyond.
      </p>
      <p class="text-fg-2 leading-relaxed">
        This series is his complete Urdu explanation of Kitab al-Tawheed — {
          urduCount
        } lectures totalling over {totalHours} hours, delivered across 15 classes.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">
        The Arabic Series
      </h2>
      <p class="text-fg-2 leading-relaxed mb-3">
        The Arabic series is the explanation of Kitab at-Tawheed by <strong
          class="text-fg">Shaikh Salih al-Fawzan Hafizahullah</strong
        >, a senior scholar and member of the Council of Senior Scholars. It
        presents the book in the original Arabic for students and Arabic-speaking
        listeners.
      </p>
      <p class="text-fg-2 leading-relaxed">
        It comprises {arabicCount} audio duroos, available at{" "}
        <a href="/arabic/" class="text-[#C9A84C] hover:underline"
          >the Arabic series page</a
        >. Together, both series offer {totalCount} free audio lessons on Tawheed.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">The App</h2>
      <p class="text-fg-2 leading-relaxed mb-4">
        The <strong class="text-fg">Kitab al-Tawheed Android app</strong> provides
        the best experience for studying both series — switch between the Urdu and
        Arabic series anytime, with offline downloads, progress tracking, Study Mode
        (Urdu series), an in-app Book tab with the full Arabic text, and background
        playback.
      </p>
      <a
        href={storeUrl}
        target="_blank"
        rel="noopener"
        class="inline-block bg-[#C9A84C] text-black font-bold px-6 py-3 rounded-xl text-sm hover:bg-[#D4B55C] transition-colors"
      >
        Download Free on Google Play
      </a>
      <a
        href="/download/"
        class="block mt-3 text-[#C9A84C] text-sm hover:underline"
        >App features & screenshots →</a
      >
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">Al Marfa Duroos</h2>
      <p class="text-fg-2 leading-relaxed mb-3">
        Kitab al-Tawheed is a course from <a
          href="https://www.youtube.com/@almarfaduroos"
          target="_blank"
          rel="noopener"
          class="text-[#C9A84C] hover:underline font-semibold"
          >Al Marfa Duroos</a
        > — free Urdu &amp; Arabic Islamic audio lessons built to make classical scholarship
        accessible to Muslims everywhere, without cost or account.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-[#C9A84C] mb-3">Contact</h2>
      <p class="text-fg-2">
        Questions or feedback? Email
        <a
          href="mailto:hello@almarfa.co"
          class="text-[#C9A84C] hover:underline"
          >hello@almarfa.co</a
        >
        or visit
        <a
          href="https://almarfa.co"
          target="_blank"
          rel="noopener"
          class="text-[#C9A84C] hover:underline"
          >almarfa.co</a
        >.
      </p>
    </section>
  </div>
</Layout>
