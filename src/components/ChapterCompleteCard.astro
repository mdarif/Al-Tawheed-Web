---
import type { Chapter } from '../lib/catalog';
import { en } from '../lib/catalog';

interface Props {
  chapter: Chapter;
  nextChapter?: Chapter;
  nextChapterHref?: string;
  playStoreUrl: string;
}

const { chapter, nextChapter, nextChapterHref, playStoreUrl } = Astro.props;
---

<div class="mt-8 bg-surface-gold border border-[#C9A84C]/30 rounded-2xl p-6">
  <p class="text-[#C9A84C] text-xs font-bold uppercase tracking-widest mb-2">Class complete</p>
  <h2 class="text-xl font-bold mb-2">You finished {en(chapter.title)}</h2>
  <p class="text-sm text-fg-2 mb-5">
    Track progress, study class-by-class, and listen offline in the Android app.
  </p>
  <div class="flex flex-col sm:flex-row gap-3">
    {nextChapter && nextChapterHref && (
      <a
        href={nextChapterHref}
        class="flex-1 text-center bg-[#C9A84C] text-black font-bold px-5 py-3 rounded-xl text-sm hover:bg-[#D4B55C] transition-colors"
      >
        Continue to {en(nextChapter.title)} →
      </a>
    )}
    {/*
      Outline/secondary when paired with "Continue to next chapter" (that's
      the primary action). Solid/primary when this is the sole CTA (course
      complete) — intentional exception to "app CTA = row-constrained text
      button everywhere," not something to "fix" back to always-outline.
    */}
    <a
      href={playStoreUrl}
      target="_blank"
      rel="noopener"
      class={
        nextChapter
          ? 'flex-1 text-center border border-[#C9A84C]/40 text-[#C9A84C] font-semibold px-5 py-3 rounded-xl text-sm hover:bg-[#C9A84C]/10 transition-colors'
          : 'inline-block w-full sm:w-auto text-center bg-[#C9A84C] text-black font-bold px-5 py-3 rounded-xl text-sm hover:bg-[#D4B55C] transition-colors'
      }
    >
      Get the app
    </a>
  </div>
  {!nextChapter && (
    <p class="text-xs text-fg-3 mt-4 text-center">
      Mubarak — you have completed all 15 classes. Review any lecture from <a href="/lectures/urdu/" class="text-[#C9A84C] hover:underline">the list</a>.
    </p>
  )}
</div>
