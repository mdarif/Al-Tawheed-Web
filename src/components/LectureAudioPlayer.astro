---
import { formatDuration } from '../lib/catalog';

interface Props {
  lectureId: string;
  lecturePath: string;
  lectureTitle: string;
  audioUrl: string;
  durationSeconds: number;
  speaker: string;
  coverImageUrl: string;
  audioLangLabel?: string;
  /** Series/album name for lock-screen (MediaSession) metadata. */
  seriesTitle?: string;
  /** Next / previous lesson URLs — drive autoplay-next + lock-screen next/prev. */
  nextHref?: string;
  prevHref?: string;
}

const {
  lectureId,
  lecturePath,
  lectureTitle,
  audioUrl,
  durationSeconds,
  speaker,
  coverImageUrl,
  audioLangLabel = 'Urdu',
  seriesTitle = 'Sharah Kitab at-Tawheed',
  nextHref,
  prevHref,
} = Astro.props;
const coverSrc = coverImageUrl;
---

<div class="bg-surface border border-[var(--divider)] rounded-2xl p-4 sm:p-5 mb-6 min-w-0" data-lecture-player>
  <div class="flex gap-3 sm:gap-4 mb-4 min-w-0">
    <img
      src={coverSrc}
      alt=""
      width="56"
      height="56"
      class="w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover shrink-0 border border-[#C9A84C]/20"
      loading="lazy"
    />
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-sm sm:text-base leading-snug line-clamp-2">{lectureTitle}</p>
      <p class="text-xs text-fg-2 mt-0.5 line-clamp-2">{speaker}</p>
    </div>
  </div>

  <div class="flex items-center justify-between gap-2 mb-3 sm:mb-4">
    <span class="text-xs text-fg-3">Playback speed</span>
    <select
      data-playback-speed
      class="bg-bg border border-[var(--divider-md)] rounded-lg px-3 py-2 text-fg text-sm min-h-[44px] min-w-[5.5rem]"
    >
      <option value="0.75">0.75×</option>
      <option value="1" selected>1×</option>
      <option value="1.25">1.25×</option>
      <option value="1.5">1.5×</option>
      <option value="2">2×</option>
    </select>
  </div>

  <audio
    id={`player-${lectureId}`}
    controls
    preload="metadata"
    class="w-full max-w-full rounded-lg accent-[#C9A84C]"
    src={audioUrl}
    data-lecture-id={lectureId}
    data-lecture-path={lecturePath}
    data-lecture-title={lectureTitle}
    data-duration-seconds={durationSeconds}
    data-speaker={speaker}
    data-series-title={seriesTitle}
    data-cover-url={coverSrc}
    data-next-href={nextHref}
    data-prev-href={prevHref}
  >
    Your browser does not support audio. <a href={audioUrl} class="text-[#C9A84C] underline">Download MP3</a>
  </audio>
  <p class="text-xs text-fg-3 mt-2 text-center px-1">
    {formatDuration(durationSeconds)} · {audioLangLabel} audio · Autoplays the next part · Progress saved in this browser
  </p>

  <!-- Shown only if the browser blocks autoplay-next (no user gesture on the
       fresh page). For active listeners, media engagement lets playback resume
       automatically and this stays hidden. -->
  <button
    type="button"
    data-autoplay-continue
    class="hidden mt-3 w-full text-center bg-[#C9A84C] text-black font-bold px-4 py-3 rounded-lg text-sm hover:bg-[#D4B55C] transition-colors min-h-[44px]"
  >
    ▶ Continue playing
  </button>
</div>

<script>
  import { initLecturePlayer } from '../scripts/playback-progress';
  import { initLecturePlayerUi } from '../scripts/lecture-player-ui';
  import { initAutoplayNext } from '../scripts/autoplay-next';
  import { initMediaSession } from '../scripts/media-session';

  const audio = document.querySelector('audio[data-lecture-id]');
  if (audio instanceof HTMLAudioElement) {
    initLecturePlayer(audio);
    initLecturePlayerUi(audio);
    initAutoplayNext(audio);
    initMediaSession(audio);
  }
</script>
