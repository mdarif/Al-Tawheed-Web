---
import { formatDuration } from '../lib/catalog';

interface Props {
  lectureId: string;
  lecturePath: string;
  lectureTitle: string;
  audioUrl: string;
  durationSeconds: number;
  speaker: string;
  playStoreUrl: string;
  coverImageUrl: string;
  audioLangLabel?: string;
}

const {
  lectureId,
  lecturePath,
  lectureTitle,
  audioUrl,
  durationSeconds,
  speaker,
  playStoreUrl,
  coverImageUrl,
  audioLangLabel = 'Urdu',
} = Astro.props;
const coverSrc = coverImageUrl;
---

<div class="bg-surface border border-[var(--divider)] rounded-2xl p-4 sm:p-5 mb-6 min-w-0" data-lecture-player data-play-store-url={playStoreUrl}>
  <div class="flex gap-3 sm:gap-4 mb-4 min-w-0">
    <img
      src={coverSrc}
      alt=""
      width="56"
      height="56"
      class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl object-cover shrink-0 border border-[#C9A84C]/20"
      loading="lazy"
    />
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-sm sm:text-base leading-snug line-clamp-2">{lectureTitle}</p>
      <p class="text-xs text-fg-2 mt-0.5 line-clamp-2">{speaker}</p>
    </div>
  </div>

  <div class="flex items-center justify-between gap-2 mb-3 sm:mb-4">
    <span class="text-xs text-fg-3">Playback speed</span>
    <select
      data-playback-speed
      class="bg-bg border border-[var(--divider-md)] rounded-lg px-3 py-2 text-fg text-sm min-h-[44px] min-w-[5.5rem]"
    >
      <option value="0.75">0.75×</option>
      <option value="1" selected>1×</option>
      <option value="1.25">1.25×</option>
      <option value="1.5">1.5×</option>
      <option value="2">2×</option>
    </select>
  </div>

  <audio
    id={`player-${lectureId}`}
    controls
    preload="metadata"
    class="w-full max-w-full rounded-lg accent-[#C9A84C]"
    src={audioUrl}
    data-lecture-id={lectureId}
    data-lecture-path={lecturePath}
    data-lecture-title={lectureTitle}
    data-duration-seconds={durationSeconds}
  >
    Your browser does not support audio. <a href={audioUrl} class="text-[#C9A84C] underline">Download MP3</a>
  </audio>
  <p class="text-xs text-fg-3 mt-2 text-center px-1">
    {formatDuration(durationSeconds)} · {audioLangLabel} audio · Progress saved in this browser
    {import.meta.env.DEV && (
      <span class="block mt-1 text-fg-3/80">
        Dev: nudge after 30s audio (~15s at 2×). Dismiss is per visit; refresh to test again.
      </span>
    )}
  </p>

  <div
    data-listen-nudge
    class="hidden mt-4 bg-surface-gold border border-[#C9A84C]/40 rounded-xl p-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="min-w-0">
      <p class="text-sm font-semibold text-[#C9A84C]">Enjoying the lecture?</p>
      <p class="text-xs text-fg-2">Continue offline with progress tracking on the free app.</p>
    </div>
    <div class="flex gap-2 shrink-0 w-full sm:w-auto">
      <a
        data-nudge-app
        href={playStoreUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 sm:flex-none text-center bg-[#C9A84C] text-black font-bold px-4 py-3 sm:py-2 rounded-lg text-sm sm:text-xs hover:bg-[#D4B55C] min-h-[44px] sm:min-h-0 flex items-center justify-center"
      >
        Get App
      </a>
      <button
        type="button"
        data-nudge-dismiss
        class="text-sm sm:text-xs text-fg-3 px-4 py-3 sm:py-2 hover:text-fg-2 min-h-[44px] sm:min-h-0"
      >
        Dismiss
      </button>
    </div>
  </div>
</div>

<script>
  import { initLecturePlayer } from '../scripts/playback-progress';
  import { initLecturePlayerUi } from '../scripts/lecture-player-ui';

  const audio = document.querySelector('audio[data-lecture-id]');
  if (audio instanceof HTMLAudioElement) {
    initLecturePlayer(audio);
    const root = audio.closest('[data-lecture-player]');
    const storeUrl = root?.getAttribute('data-play-store-url') ?? '';
    const lectureId = audio.dataset.lectureId ?? '';
    initLecturePlayerUi(audio, storeUrl, lectureId);
  }
</script>
