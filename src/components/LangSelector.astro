---
import { altLocaleUrl } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const path = Astro.url.pathname;
const altPath = altLocaleUrl(locale, path);
---

<nav aria-label="Language selector" class="flex items-center gap-1.5 text-sm">
  <a
    href={locale === "en" ? path : altPath}
    aria-current={locale === "en" ? "true" : undefined}
    hreflang="en"
    lang="en"
    data-lang="en"
    class:list={[
      "font-semibold transition-colors",
      locale === "en" ? "text-fg" : "text-fg-3 hover:text-fg-2",
    ]}
  >EN</a>
  <span class="text-fg-4 select-none" aria-hidden="true">|</span>
  <a
    href={locale === "ur" ? path : altPath}
    aria-current={locale === "ur" ? "true" : undefined}
    hreflang="ur"
    lang="ur"
    data-lang="ur"
    class:list={[
      "font-semibold transition-colors",
      locale === "ur" ? "text-fg" : "text-fg-3 hover:text-fg-2",
    ]}
  >اردو</a>
</nav>

<script is:inline>
  document.querySelectorAll("[data-lang]").forEach(function (el) {
    el.addEventListener("click", function () {
      localStorage.setItem("tawheed:locale", this.dataset.lang);
    });
  });
</script>
