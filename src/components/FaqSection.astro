---
import type { FaqItem } from '../lib/faq';
import { faqPageJsonLd } from '../lib/faq';

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Frequently asked questions' } = Astro.props;
const jsonLd = faqPageJsonLd(items);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

<section class="mt-12 border-t border-[var(--divider)] pt-10">
  <h2 class="text-xl font-bold text-[#C9A84C] mb-6">{heading}</h2>
  <div class="space-y-4">
    {items.map((item) => (
      <details class="group bg-surface border border-[var(--divider)] rounded-xl px-5 py-4 open:border-[#C9A84C]/30">
        <summary class="font-semibold cursor-pointer list-none flex items-center justify-between gap-3">
          <span>{item.question}</span>
          <span class="text-[#C9A84C] text-sm shrink-0 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <p class="text-fg-2 text-sm leading-relaxed mt-3">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
