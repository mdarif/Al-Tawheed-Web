---
/** Client-hydrated card; reads last playback position from localStorage. */
---

<section id="continue-listening" class="hidden mx-auto max-w-3xl px-4 sm:px-6 py-6 min-w-0">
  <h2 class="text-lg font-bold mb-3">Continue Listening</h2>

  <div data-continue-card class="bg-[#1A1A1C] border border-white/10 rounded-2xl p-5 hover:border-[#C9A84C]/40 transition-colors">
    <a data-continue-link href="/lectures/" class="block">
      <div class="flex items-center gap-4">
        <div class="w-11 h-11 flex items-center justify-center bg-[#C9A84C]/10 rounded-xl shrink-0 text-xl" aria-hidden="true">🎧</div>
        <div class="min-w-0 flex-1">
          <p data-continue-title class="font-semibold truncate">…</p>
          <p data-continue-meta class="text-xs text-[#A09880] mt-0.5">…</p>
        </div>
        <span class="w-9 h-9 flex items-center justify-center bg-[#C9A84C] text-black rounded-full shrink-0 text-lg" aria-hidden="true">▶</span>
      </div>
      <div class="mt-4 h-1 bg-white/10 rounded-full overflow-hidden">
        <div data-continue-bar class="h-full bg-[#C9A84C] rounded-full transition-all" style="width: 0%"></div>
      </div>
      <p data-continue-pct class="text-xs text-[#6B6458] mt-1.5">0% complete</p>
    </a>
  </div>
</section>

<script>
  import { initContinueListening } from '../scripts/playback-progress';
  initContinueListening('continue-listening');
</script>
