---
import LangSelector from "./LangSelector.astro";
import { localizePath } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const localize = (path: string) => localizePath(path, locale);

const downloadHref = localize("/download/");

// The two audio series are the primary content, surfaced as explicit, symmetric
// links. The /lectures/ hub and the SEO explainer pages live in the footer.
// The gold "Get the app" pill is the download entry point, so there's no
// separate "Download App" text link (it would be a second link to the same page).
const links = [
  { href: localize("/lectures/urdu/"), label: 'Urdu Series' },
  { href: '/arabic/', label: 'Arabic Series' },
  { href: localize("/search/"), label: 'Search' },
  { href: localize("/about/"), label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--divider)] bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto max-w-5xl flex items-center justify-between gap-2 px-4 py-3 min-w-0">
    <a
      href={locale === "ur" ? "/ur/" : "/"}
      class="hover:opacity-80 transition-opacity min-w-0 shrink flex items-center gap-2.5"
    >
      <img
        src="/icons/icon-192.png"
        alt=""
        width="34"
        height="34"
        class="w-[34px] h-[34px] rounded-lg shrink-0"
      />
      <span class="flex flex-col leading-tight min-w-0">
        <span class="hidden md:block text-[10px] text-fg-3 font-medium tracking-widest uppercase">Al Marfa Duroos</span>
        <span class="text-[#C9A84C] font-semibold text-sm tracking-wide md:hidden">Kitab at-Tawheed</span>
        <span class="text-[#C9A84C] font-semibold text-sm tracking-wide hidden md:inline">Sharah Kitab at-Tawheed</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-4 lg:gap-5 text-sm text-fg-2 shrink-0" aria-label="Main">
      {links.map(({ href, label }) => (
        <a href={href} class="hover:text-fg transition-colors whitespace-nowrap">{label}</a>
      ))}
      <LangSelector />
      <!-- Theme toggle — desktop -->
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle theme"
        class="p-1.5 rounded-lg border border-[var(--divider)] text-fg-2 hover:text-fg hover:border-[var(--divider-md)] transition-colors"
      >
        <svg id="icon-sun" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg id="icon-moon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a
        href={downloadHref}
        class="bg-[#C9A84C] text-black font-semibold px-3 py-1.5 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors whitespace-nowrap"
      >
        Get the app
      </a>
    </nav>

    <div class="flex md:hidden items-center gap-1.5 shrink-0">
      <!-- Download funnel from the native app is mostly mobile traffic, so
           this stays in the always-visible bar rather than behind the
           hamburger — a tap to open a menu just to find it costs conversions. -->
      <a
        href={downloadHref}
        class="bg-[#C9A84C] text-black font-semibold px-2.5 py-1.5 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors whitespace-nowrap"
      >
        Get app
      </a>
      <LangSelector />
      <!-- Theme toggle — mobile -->
      <button
        type="button"
        id="theme-toggle-mobile"
        aria-label="Toggle theme"
        class="p-2 rounded-lg border border-[var(--divider)] text-fg-2 hover:text-fg hover:bg-surface-hover transition-colors"
      >
        <svg id="icon-sun-m" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg id="icon-moon-m" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button
        type="button"
        id="site-nav-toggle"
        class="p-2 -mr-1 rounded-lg border border-[var(--divider)] text-fg hover:bg-surface-hover"
        aria-expanded="false"
        aria-controls="site-nav-panel"
        aria-label="Open menu"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="site-nav-panel" class="hidden md:hidden border-t border-[var(--divider)] bg-bg" aria-label="Mobile menu">
    <nav class="mx-auto max-w-5xl px-4 py-3 flex flex-col gap-1 text-sm">
      {links.map(({ href, label }) => (
        <a href={href} class="py-2.5 text-fg-2 hover:text-[#C9A84C] border-b border-[var(--divider-sm)] last:border-0">
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // ── Mobile nav toggle ────────────────────────────────────────────────────
  const toggle = document.getElementById('site-nav-toggle');
  const panel = document.getElementById('site-nav-panel');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const willOpen = panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
    });
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        panel.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      });
    });
  }

  // ── Theme toggle ─────────────────────────────────────────────────────────
  function applyTheme(theme: string) {
    const html = document.documentElement;
    if (theme === 'light') {
      html.dataset.theme = 'light';
    } else {
      delete html.dataset.theme;
    }
    // Keep the browser/PWA chrome color in sync with the active theme
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'light' ? '#FAF8F5' : '#1A1A1C');
    // Update sun/moon icons on both buttons
    ['', '-m'].forEach(suffix => {
      const sun  = document.getElementById(`icon-sun${suffix}`);
      const moon = document.getElementById(`icon-moon${suffix}`);
      if (!sun || !moon) return;
      if (theme === 'light') {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
      } else {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      }
    });
  }

  function handleToggle() {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    localStorage.setItem('tawheed:theme', next);
  }

  // Sync icons with current theme on page load
  const saved = localStorage.getItem('tawheed:theme') ?? 'dark';
  applyTheme(saved);

  document.getElementById('theme-toggle')?.addEventListener('click', handleToggle);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', handleToggle);
</script>
