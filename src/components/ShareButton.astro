---
// Web Share API button with a copy-link fallback + toast. Originally
// duplicated across the two lecture player pages (Urdu + Arabic); extracted
// here once book reader pages needed the same behavior too.
interface Props {
  label: string;
  ariaLabel: string;
  toastMessage: string;
  shareText?: string;
  class?: string;
}

const { label, ariaLabel, toastMessage, shareText, class: className } = Astro.props;
---

<button
  id="share-btn"
  type="button"
  class={`flex items-center gap-1.5 text-xs text-fg-3 border border-[var(--divider)] rounded-lg px-3 py-1.5 hover:text-fg hover:border-[var(--divider-md)] transition-colors shrink-0 ${className ?? ""}`}
  aria-label={ariaLabel}
  data-share-text={shareText}
>
  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
  </svg>
  {label}
</button>

<div
  id="share-toast"
  class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-surface border border-[var(--divider)] rounded-xl px-4 py-2.5 text-sm shadow-lg opacity-0 pointer-events-none transition-opacity duration-300"
  aria-live="polite"
>
  {toastMessage}
</div>

<script is:inline define:vars={{ toastMessage }}>
  (function () {
    var btn = document.getElementById('share-btn');
    var toast = document.getElementById('share-toast');
    var toastTimer;

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () {
        toast.classList.add('opacity-0');
      }, 2200);
    }

    function copyFallback() {
      navigator.clipboard.writeText(location.href).then(function () {
        showToast(toastMessage);
      }).catch(function () {
        showToast(location.href);
      });
    }

    if (btn) {
      btn.addEventListener('click', function () {
        var shareText = btn.getAttribute('data-share-text');
        var payload = { title: document.title, url: location.href };
        if (shareText) payload.text = shareText;
        if (navigator.share) {
          navigator.share(payload).catch(function (e) {
            if (e.name !== 'AbortError') copyFallback();
          });
        } else {
          copyFallback();
        }
      });
    }
  })();
</script>
