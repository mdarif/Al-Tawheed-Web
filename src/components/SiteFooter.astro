---
interface Props {
  storeUrl: string;
}

const { storeUrl } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/lectures/', label: 'Lectures' },
  { href: '/search/', label: 'Search' },
  { href: '/download/', label: 'Download App' },
  { href: '/kitab-al-tawheed/', label: 'Kitab' },
  { href: '/tawheed/', label: 'Tawheed' },
  { href: '/about/', label: 'About' },
  { href: storeUrl, label: 'Google Play', external: true },
];
---

<footer class="mt-12 border-t border-white/10 pt-8 pb-[calc(2rem+env(safe-area-inset-bottom,0px))] md:pb-8 px-4 text-center text-xs text-[#6B6458]">
  <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 max-w-lg mx-auto mb-3" aria-label="Footer">
    {links.map(({ href, label, external }) => (
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
        class={label === 'Home' ? 'text-[#C9A84C] hover:underline' : 'hover:text-[#A09880]'}
      >
        {label}
      </a>
    ))}
  </nav>
  <p>Free Islamic lectures · No ads · No tracking</p>
</footer>
