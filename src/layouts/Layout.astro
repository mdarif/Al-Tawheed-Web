---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { AppConfig } from "../lib/catalog";
import { SITE_URL } from "../lib/catalog";
import { altLocaleUrl, hasTranslation, TRANSLATED_PATHS } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  appConfig?: AppConfig;
  /** Absolute URL for Open Graph / Twitter preview image */
  ogImage?: string;
  /** Alt text describing the OG image content (for accessibility + crawlers) */
  ogImageAlt?: string;
  /** Open Graph site name (defaults to brand name) */
  ogSiteName?: string;
  /** Open Graph content type: 'website' or 'article' */
  ogType?: string;
  /** Article tags for content pages */
  articleTags?: string[];
  /** Explicit OG image dimensions — only set when you know the exact size */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** FAQPage structured data — array of {question, answer} pairs */
  faqItems?: ReadonlyArray<{ question: string; answer: string }>;
  /** Override html[lang] — use for non-locale-routed pages like /arabic/ */
  lang?: string;
  /** Override html[dir] — use 'rtl' for Arabic/Urdu pages */
  dir?: 'ltr' | 'rtl';
}

const {
  title,
  description = "50 Urdu + 91 Arabic Audio Lessons on Kitab at-Tawheed • Free • Online & Offline",
  ogImageAlt = "Kitab at-Tawheed — complete audio series in Arabic & Urdu, by Shaikh Salih al-Fawzan and Shaikh Abdullah Nasir Rahmani",
  ogSiteName = "Al Marfa Duroos",
  ogType = "website",
  articleTags = [],
  ogImageWidth,
  ogImageHeight,
  faqItems,
  lang: langProp,
  dir: dirProp,
} = Astro.props;

// Resolve OG image: default to the dedicated social card (known 1200x630).
// When a caller passes a custom ogImage (e.g. the CDN book cover), we don't
// know its dimensions, so we suppress the width/height tags unless explicitly provided.
const resolvedOgImage = Astro.props.ogImage ?? `${SITE_URL}/og-image.png`;
const resolvedOgImageWidth =
  ogImageWidth ?? (Astro.props.ogImage ? undefined : 1200);
const resolvedOgImageHeight =
  ogImageHeight ?? (Astro.props.ogImage ? undefined : 630);

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const locale = Astro.currentLocale ?? "en";
// Chrome "Get the app" CTAs navigate to the on-site download page (which then
// carries the Google Play badge); only the badge itself jumps to the store.
const downloadHref = locale === "ur" ? "/ur/download/" : "/download/";
const htmlLang = langProp ?? locale;
const htmlDir = dirProp ?? (locale === "ur" ? "rtl" : undefined);
const isArabicPage = htmlLang === "ar";
const altPath = altLocaleUrl(locale, Astro.url.pathname);
const enUrl = locale === "en" ? canonicalUrl : new URL(altPath, SITE_URL).toString();
const urUrl = locale === "ur" ? canonicalUrl : new URL(altPath, SITE_URL).toString();
// Only emit hreflang alternates for pages that actually have an Urdu version;
// otherwise the ur alternate would point to a nonexistent /ur/ page (404).
const hasUrdu = hasTranslation(Astro.url.pathname);
// og:locale must match the page's actual language; the alternate is only
// meaningful when a translated counterpart exists.
const ogLocale = isArabicPage ? "ar_SA" : locale === "ur" ? "ur_PK" : "en_US";
const ogLocaleAlternate = locale === "ur" ? "en_US" : "ur_PK";
// The AudioSeries JSON-LD describes the site's flagship series, so it belongs
// on the homepage only — not on utility pages like /privacy/ or /404.
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "/ur/";
// Cloudflare Web Analytics site tag. This is a PUBLIC token (it's exposed in
// the client beacon to every visitor — not a secret), so it's safe to commit
// as the default; a PUBLIC_CF_WEB_ANALYTICS_TOKEN env var overrides it if set.
const cfAnalyticsToken =
  import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN?.trim() ||
  "af51cc49863e475e94633e27f3b21ecf";
const fbAppId = import.meta.env.PUBLIC_FB_APP_ID?.trim() ?? "";
const twitterCreator = import.meta.env.PUBLIC_TWITTER_CREATOR?.trim() ?? "";

// Ensure OG image is always absolute for social media crawlers
const absoluteOgImage = resolvedOgImage.startsWith("http")
  ? resolvedOgImage
  : new URL(resolvedOgImage, SITE_URL).toString();
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir} class="scroll-smooth">
  <head>
    <!-- Prevent flash of wrong theme: set data-theme before first paint -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("tawheed:theme");
        if (t === "light") document.documentElement.dataset.theme = "light";
      })();
    </script>
    <!-- Enforce saved locale preference before first paint.
         urduPages is injected from TRANSLATED_PATHS so there's one source of truth. -->
    <script is:inline define:vars={{ urduPages: TRANSLATED_PATHS }}>
      (function () {
        var pref = localStorage.getItem("tawheed:locale");
        if (pref !== "ur") return;
        var path = window.location.pathname;
        var isUrdu = path === "/ur/" || path === "/ur" || path.startsWith("/ur/");
        if (isUrdu) return;
        // Only redirect for pages that have actual translated versions
        if (urduPages.indexOf(path) !== -1) {
          window.location.replace("/ur" + (path === "/" ? "/" : path));
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hasUrdu && (
      <>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="ur" href={urUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    )}
    {(locale === "ur" || isArabicPage) && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
        />
      </>
    )}

    <!-- Facebook / Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content={ogLocale} />
    {hasUrdu && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    {
      resolvedOgImageWidth && (
        <meta
          property="og:image:width"
          content={String(resolvedOgImageWidth)}
        />
      )
    }
    {
      resolvedOgImageHeight && (
        <meta
          property="og:image:height"
          content={String(resolvedOgImageHeight)}
        />
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    {fbAppId && <meta property="fb:app_id" content={fbAppId} />}
    {
      ogType === "article" && (
        <>
          <meta property="article:section" content="Islamic Education" />
          {articleTags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1A1A1C" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sharah Kitab at-Tawheed"
      href="/feed.xml"
    />

    <!-- JSON-LD Structured Data -->
    {
      isHomepage && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "AudioSeries",
            name: "Sharah Kitab at-Tawheed",
            description: "Complete Urdu audio explanation (sharah) of Kitab at-Tawheed by Shaikh Abdullah Nasir Rahmani — 50 lectures across 15 classes, free. An Arabic series by Shaikh Salih al-Fawzan is also available.",
            url: "https://kitabattawheed.com",
            image: `${SITE_URL}/og-image.png`,
            creator: {
              "@type": "Person",
              name: "Shaikh Abdullah Nasir Rahmani",
            },
            publisher: {
              "@type": "Organization",
              name: "Al Marfa Duroos",
            },
            numberOfEpisodes: 50,
            inLanguage: "ur",
          })}
        />
      )
    }
    {
      faqItems && faqItems.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: { "@type": "Answer", text: item.answer },
            })),
          })}
        />
      )
    }

    <slot name="head" />
  </head>
  <body
    class="site-body bg-bg text-fg font-sans antialiased min-h-dvh flex flex-col"
  >
    <a href="#main-content" class="skip-link">Skip to content</a>

    <SiteHeader />

    <main id="main-content" class="flex-1 w-full min-w-0 main-with-mobile-cta">
      <slot />
    </main>

    <div
      class="mobile-cta-bar fixed bottom-0 inset-x-0 z-40 md:hidden bg-surface/95 border-t border-[var(--divider)] backdrop-blur-sm"
      aria-hidden="false"
    >
      <div
        class="flex items-center justify-between gap-3 px-4 py-3 max-w-5xl mx-auto min-w-0"
      >
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold truncate">
            Listen offline — Free app
          </p>
          <p class="text-[10px] text-fg-2 truncate">
            Progress · Background play
          </p>
        </div>
        <a
          href={downloadHref}
          class="shrink-0 bg-[#C9A84C] text-black font-bold px-4 py-2.5 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors"
        >
          Get the app
        </a>
      </div>
    </div>

    <SiteFooter />

    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
        });
      }
    </script>
  </body>
</html>
