---
import '../styles/global.css';
import type { AppConfig } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
  appConfig?: AppConfig;
}

const {
  title,
  description = 'Listen to Sharah Kitab al-Tawheed — 50 Urdu audio lectures by Shaikh Abdullah Nasir Rahmani. Free online and on Android.',
  appConfig,
} = Astro.props;

const playStoreUrl = appConfig?.links?.playStore ?? 'https://play.google.com/store/apps/details?id=com.almarfa.tawheed';
const canonicalUrl = new URL(Astro.url.pathname, 'https://kitabattawheed.com').toString();
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
</head>
<body class="bg-[#0F0F10] text-[#F0EDE4] font-sans antialiased">

  <!-- Top nav -->
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0F0F10]/90 backdrop-blur-sm">
    <div class="mx-auto max-w-5xl flex items-center justify-between px-4 py-3">
      <a href="/" class="text-[#C9A84C] font-semibold text-sm tracking-wide hover:opacity-80 transition-opacity">
        Sharah Kitab al-Tawheed
      </a>
      <nav class="flex items-center gap-5 text-sm text-[#A09880]">
        <a href="/lectures/" class="hover:text-[#F0EDE4] transition-colors">Lectures</a>
        <a href="/about/" class="hover:text-[#F0EDE4] transition-colors">About</a>
        <a
          href={playStoreUrl}
          target="_blank"
          rel="noopener"
          class="bg-[#C9A84C] text-black font-semibold px-3 py-1.5 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors"
        >
          Get App ↓
        </a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Sticky bottom bar on mobile -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-[#1A1A1C] border-t border-white/10 p-3 flex items-center justify-between gap-3 md:hidden">
    <div>
      <p class="text-xs font-semibold">Listen offline — Download free</p>
      <p class="text-[10px] text-[#A09880]">Background playback · Progress tracking</p>
    </div>
    <a
      href={playStoreUrl}
      target="_blank"
      rel="noopener"
      class="bg-[#C9A84C] text-black font-bold px-4 py-2 rounded-lg text-xs whitespace-nowrap hover:bg-[#D4B55C] transition-colors"
    >
      Google Play
    </a>
  </div>

  <footer class="mt-16 mb-16 md:mb-0 border-t border-white/10 py-8 text-center text-xs text-[#6B6458]">
    <p>
      <a href="/" class="text-[#C9A84C] hover:underline">Sharah Kitab al-Tawheed</a>
      · <a href="/lectures/" class="hover:text-[#A09880]">Lectures</a>
      · <a href="/about/" class="hover:text-[#A09880]">About</a>
      · <a href={playStoreUrl} target="_blank" rel="noopener" class="hover:text-[#A09880]">Android App</a>
    </p>
    <p class="mt-2">Free Islamic lectures · No ads · No tracking</p>
  </footer>

</body>
</html>
