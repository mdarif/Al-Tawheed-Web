---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { AppConfig } from "../lib/catalog";
import { SITE_URL, playStoreUrl } from "../lib/catalog";
import { altLocaleUrl } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  appConfig?: AppConfig;
  /** Absolute URL for Open Graph / Twitter preview image */
  ogImage?: string;
  /** Alt text describing the OG image content (for accessibility + crawlers) */
  ogImageAlt?: string;
  /** Open Graph site name (defaults to brand name) */
  ogSiteName?: string;
  /** Open Graph content type: 'website' or 'article' */
  ogType?: string;
  /** Article tags for content pages */
  articleTags?: string[];
  /** Explicit OG image dimensions — only set when you know the exact size */
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title,
  description = "50 Urdu Audio Lessons • 27+ Hours • Online & Offline",
  appConfig,
  ogImageAlt = "Sharah Kitab al-Tawheed | Urdu Audio Series, 27+ Hours",
  ogSiteName = "Kitab At-Tawheed — The Foundation of Tawheed",
  ogType = "website",
  articleTags = [],
  ogImageWidth,
  ogImageHeight,
} = Astro.props;

// Resolve OG image: default to the dedicated social card (known 1200x630).
// When a caller passes a custom ogImage (e.g. the CDN book cover), we don't
// know its dimensions, so we suppress the width/height tags unless explicitly provided.
const resolvedOgImage = Astro.props.ogImage ?? `${SITE_URL}/og-image.png`;
const resolvedOgImageWidth =
  ogImageWidth ?? (Astro.props.ogImage ? undefined : 1200);
const resolvedOgImageHeight =
  ogImageHeight ?? (Astro.props.ogImage ? undefined : 630);

const storeUrl = appConfig
  ? playStoreUrl(appConfig)
  : "https://play.google.com/store/apps/details?id=com.almarfa.tawheed";
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const locale = Astro.currentLocale ?? "en";
const altPath = altLocaleUrl(locale, Astro.url.pathname);
const enUrl = locale === "en" ? canonicalUrl : new URL(altPath, SITE_URL).toString();
const urUrl = locale === "ur" ? canonicalUrl : new URL(altPath, SITE_URL).toString();
const cfAnalyticsToken =
  import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN?.trim() ?? "";
const fbAppId = import.meta.env.PUBLIC_FB_APP_ID?.trim() ?? "";
const twitterCreator = import.meta.env.PUBLIC_TWITTER_CREATOR?.trim() ?? "";

// Ensure OG image is always absolute for social media crawlers
const absoluteOgImage = resolvedOgImage.startsWith("http")
  ? resolvedOgImage
  : new URL(resolvedOgImage, SITE_URL).toString();
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <!-- Prevent flash of wrong theme: set data-theme before first paint -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("tawheed:theme");
        if (t === "light") document.documentElement.dataset.theme = "light";
      })();
    </script>
    <!-- Enforce saved locale preference before first paint -->
    <script is:inline>
      (function () {
        var pref = localStorage.getItem("tawheed:locale");
        if (pref !== "ur") return;
        var path = window.location.pathname;
        var isUrdu = path === "/ur/" || path === "/ur" || path.startsWith("/ur/");
        if (isUrdu) return;
        // Only redirect for pages that have actual translated versions
        var urduPages = ["/", "/about/", "/kitab-al-tawheed/", "/tawheed/", "/download/"];
        if (urduPages.indexOf(path) !== -1) {
          window.location.replace("/ur" + (path === "/" ? "/" : path));
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ur" href={urUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    {locale === "ur" && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
      />
    )}

    <!-- Facebook / Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ur_PK" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    {
      resolvedOgImageWidth && (
        <meta
          property="og:image:width"
          content={String(resolvedOgImageWidth)}
        />
      )
    }
    {
      resolvedOgImageHeight && (
        <meta
          property="og:image:height"
          content={String(resolvedOgImageHeight)}
        />
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    {fbAppId && <meta property="fb:app_id" content={fbAppId} />}
    {
      ogType === "article" && (
        <>
          <meta property="article:section" content="Islamic Education" />
          {articleTags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sharah Kitab al-Tawheed"
      href="/feed.xml"
    />

    <!-- JSON-LD Structured Data -->
    {
      ogType === "website" && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "AudioSeries",
            name: "Sharah Kitab At-Tawheed",
            description: "50 Urdu Audio Lessons • 27+ Hours • Online & Offline",
            url: "https://kitabattawheed.com",
            image: `${SITE_URL}/og-image.png`,
            creator: {
              "@type": "Person",
              name: "Shaikh Abdullah Nasir Rahmani",
            },
            numberOfEpisodes: 50,
            inLanguage: "ur",
          })}
        />
      )
    }

    <slot name="head" />
  </head>
  <body
    class="site-body bg-bg text-fg font-sans antialiased min-h-dvh flex flex-col"
  >
    <SiteHeader {storeUrl} />

    <main class="flex-1 w-full min-w-0 main-with-mobile-cta">
      <slot />
    </main>

    <div
      class="mobile-cta-bar fixed bottom-0 inset-x-0 z-40 md:hidden bg-surface/95 border-t border-[var(--divider)] backdrop-blur-sm"
      aria-hidden="false"
    >
      <div
        class="flex items-center justify-between gap-3 px-4 py-3 max-w-5xl mx-auto min-w-0"
      >
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold truncate">
            Listen offline — Free app
          </p>
          <p class="text-[10px] text-fg-2 truncate">
            Progress · Background play
          </p>
        </div>
        <a
          href={storeUrl}
          target="_blank"
          rel="noopener"
          class="shrink-0 bg-[#C9A84C] text-black font-bold px-4 py-2.5 rounded-lg text-xs hover:bg-[#D4B55C] transition-colors"
        >
          Google Play
        </a>
      </div>
    </div>

    <SiteFooter {storeUrl} />

    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }
  </body>
</html>
