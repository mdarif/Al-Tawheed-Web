#!/bin/sh
# Gate: run the full Playwright suite before every push (incl. to main → prod).
# A push — and therefore a Cloudflare production deploy — cannot go through
# unless all tests pass. Committed + auto-wired via the "prepare" npm script
# (git config core.hooksPath .githooks). Bypass in a pinch: git push --no-verify

echo ""
echo "Running Playwright suite before push (builds site first, ~1-3 min)..."
echo "Skip with: git push --no-verify"
echo ""

npx playwright test --reporter=list

if [ $? -ne 0 ]; then
  echo ""
  echo "Tests FAILED. Push aborted — nothing deployed."
  echo "Run 'npm test' for full output, or 'npm run test:report' for the HTML report."
  exit 1
fi

echo ""
echo "All tests passed — pushing."
