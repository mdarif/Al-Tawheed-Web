# Cloudflare Web Analytics beacon token (optional in local dev).
# Production: set in Cloudflare Pages → Settings → Environment variables.
# Dashboard: Analytics & Logs → Web Analytics → your site → Manage site.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Optional: Facebook App ID for better OG sharing analytics and pixel tracking.
# Get from https://developers.facebook.com/apps
PUBLIC_FB_APP_ID=
