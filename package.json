{
  "name": "kitab-at-tawheed-web",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "dev:full": "npm run build && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=al-tawheed-web",
    "astro": "astro",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "astro-pagefind": "^2.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "wrangler": "^4.14.0"
  }
}
